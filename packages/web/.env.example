# Open Persona — web app environment (spec 09). Copy to `.env.local` and fill in.
# Never commit real secrets; `.env*` is gitignored (this template is the exception).

# --- API (spec 08) ---
# Base URL of the persona-api. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Voice (persona-voice; Spec V6) ---
# Base URL of the SEPARATE persona-voice deployment (POST /v1/voice/token,
# GET /v1/voices) that the browser's WebRTC client talks to directly.
# PRODUCTION MUST SET THIS — if unset, voice silently falls back to
# http://localhost:8001 and calls will fail to reach a real deployment.
NEXT_PUBLIC_VOICE_BASE_URL=http://localhost:8001

# --- Auth: Clerk (D-09-2) ---
# From the Clerk dashboard. The publishable key is exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# The Clerk JWT template whose token is sent as `Authorization: Bearer` to the API.
# The template MUST set `aud` to match the API's PERSONA_API_JWT_AUDIENCE, and the
# API must set PERSONA_API_JWT_ALGORITHMS=RS256 + PERSONA_API_JWT_PUBLIC_KEY=<Clerk PEM>.
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=persona-api
# Auth routing.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Post-auth fallback lands on the auth-aware root `/`, which then routes to the
# fast-launch dashboard (returning users) or onboarding (new users).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Marketing / docs (in-app home is auth-aware, NOT a marketing page) ---
# The canonical marketing front door is the standalone marketing site. A
# signed-out visitor hitting the app root `/` is redirected here. If unset,
# `/` falls back to the in-app /sign-in route (app stays usable standalone).
NEXT_PUBLIC_MARKETING_URL=https://openpersona.example
# Optional: where the onboarding "Read the docs" button points. If unset, the
# button renders an inert `#` anchor until docs exist.
NEXT_PUBLIC_DOCS_URL=https://openpersona.example/docs

# --- App base URL (metadata) ---
# Absolute-URL base the web app resolves OG/twitter-image + manifest/icon tags
# against (Next `metadataBase`). Falls back to http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
