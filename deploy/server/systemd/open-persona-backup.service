# Open Persona nightly backup. Installed by bin/provision.sh into /etc/systemd/system.
# Runs as root: the api's data is owned by the data uid (2001) with private modes, and the
# operator (deploy, uid 2000) deliberately does not own it. The backup is written 0600.
[Unit]
Description=Open Persona nightly backup (database, roles, api data)
Wants=docker.service
After=docker.service
# A failed backup is never silent: it raises an alert (bin/alert.sh).
OnFailure=open-persona-alert@%n.service

[Service]
Type=oneshot
Environment=OP_ENV_DIR=/opt/open-persona/env
Environment=OP_DATA_DIR=/srv/open-persona
# The off-site copy's command, if set (env/offsite.env.example; RUNBOOK.md, "Backups off
# the host"). Absent or empty, the backup runs locally and reports the copy as PENDING.
EnvironmentFile=-/opt/open-persona/env/offsite.env
ExecStart=/opt/open-persona/repo/deploy/server/bin/backup.sh
Nice=10
IOSchedulingClass=idle
