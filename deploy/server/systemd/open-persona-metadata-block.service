# Open Persona: bridged containers cannot reach the link-local range (cloud metadata, and on
# Oracle the iSCSI and other instance services, all on 169.254.0.0/16). Installed by
# bin/provision.sh. Re-applied whenever Docker (re)starts, because the rule lives in
# Docker's DOCKER-USER chain, which does not survive a reboot.
[Unit]
Description=Drop container traffic to 169.254.0.0/16
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.0.0/16 -j DROP 2>/dev/null || iptables -I DOCKER-USER -d 169.254.0.0/16 -j DROP'
ExecStop=/bin/sh -c 'iptables -D DOCKER-USER -d 169.254.0.0/16 -j DROP 2>/dev/null || true'

[Install]
WantedBy=docker.service
