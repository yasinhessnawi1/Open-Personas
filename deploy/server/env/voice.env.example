# Open Persona on Hetzner: voice-only settings (compose env_file, after common.env).
# TEMPLATE: tokens are explained in common.env.example. Never put a real value here.
#
# Voice's own Fly secret NAMES were lost in the 2026-10-02 capture (secret_names.txt has
# `*` lines for it), so this list is rebuilt from persona_voice.config.VoiceConfig and the
# STT/TTS configs, not copied from Fly.

# --- database: the SAME RLS-enforced persona_app role the api's request path uses ---
PERSONA_VOICE_DATABASE_URL=postgresql+psycopg://persona_app:__GEN_APP_DB_PASSWORD__@postgres:5432/persona

# --- auth: the PRODUCTION Clerk instance's PEM, the same value as the api's
# PERSONA_API_JWT_PUBLIC_KEY. Owner-supplied, never copied from .env (dev instance). ---
PERSONA_VOICE_JWT_PUBLIC_KEY=__OWNER_CLERK_PROD__
# The web app's origin(s), comma separated: the browser calls voice directly.
PERSONA_VOICE_CORS_ORIGINS=__OWNER__

# --- LiveKit: ONE of two modes, chosen with render_env.py --livekit ---
#   selfhosted: wss://livekit.openpersonasai.com and a key pair generated on the box
#               (the same pair goes into livekit.env); start compose with
#               --profile selfhosted-livekit.
#   cloud:      the LiveKit Cloud project's URL, key and secret. render_env.py copies them
#               from .env's PERSONA_LIVEKIT_URL / _API_KEY / _API_SECRET, which the owner
#               confirms are the Cloud credentials (no setting reads those names today).
# The browser receives this same URL from POST /v1/voice/token, so it must be public.
PERSONA_VOICE_LIVEKIT_URL=__LIVEKIT_URL__
PERSONA_VOICE_LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
PERSONA_VOICE_LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__

# --- behaviour and tuning (.env; confirm each is the prod state) ---
PERSONA_VOICE_GRAPH_MEMORY_ENABLED=__FROM_ENV__
PERSONA_VOICE_DELEGATION_ENABLED=__FROM_ENV__
PERSONA_STT_SILERO_ACTIVATION_THRESHOLD=__FROM_ENV__
PERSONA_STT_SILERO_MIN_SPEECH_DURATION_MS=__FROM_ENV__
