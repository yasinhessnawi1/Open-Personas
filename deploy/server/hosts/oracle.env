# Host profile: the CORE host on Oracle Cloud Always Free (owner ruling 2026-11-07).
# VM.Standard.A1.Flex, Ampere arm64, 2 OCPU, 12 GB RAM, eu-frankfurt-1, Ubuntu 24.04.
#
# NOT secret, and tracked: plain OP_* settings only (scripts/tests/test_server_kit_hosts.py
# refuses anything else). bin/lib/compose.sh hands this file to `docker compose
# --env-file`, so every ${OP_...} in docker-compose.yml takes its value from here, the same
# for a restore, a backup and a deploy. Change a size here, then `bin/deploy.sh
# --skip-build` recreates the containers with it.
#
# The host is shared with the owner's other work (under /home/ubuntu). It is assumed idle
# for now (2026-11-07); if it starts using real memory, raise OP_HOST_RESERVED_GB and lower
# the limits below until the budget test passes again.

# --- the hostnames this host serves (owner, 2026-11-07: the domain is openpersonas.si) --
# One place: Caddy gets them through compose, preflight checks their DNS, deploy smokes
# the api through Caddy. The web is on Vercel (openpersonas.si, app., www.); voice. and
# livekit. belong to the voice host.
OP_API_HOST=api.openpersonas.si
OP_CONNECTORS_HOST=connectors.openpersonas.si

# --- the memory budget the limits must fit -------------------------------------------------
OP_HOST_RAM_GB=12
# Kept free of container limits: the OS, dockerd, oracle-cloud-agent, sshd, the page cache
# Postgres relies on, a build, and the owner's other work.
OP_HOST_RESERVED_GB=3.5

# --- postgres -------------------------------------------------------------------------------
OP_PG_MEM_LIMIT=3g
OP_PG_SHARED_BUFFERS=1GB
OP_PG_EFFECTIVE_CACHE_SIZE=3GB
OP_PG_MAINTENANCE_WORK_MEM=256MB
OP_PG_WORK_MEM=8MB
OP_PG_MAX_CONNECTIONS=60
OP_PG_MAX_WAL_SIZE=1GB

# --- api and caddy --------------------------------------------------------------------------
# The api holds the bge embedder, the reranker and the crisis encoder resident (about 2 to
# 2.5 GB with torch); one uvicorn worker, never more (packages/api/Dockerfile).
OP_API_MEM_LIMIT=4g
OP_CADDY_MEM_LIMIT=256m

# --- the host itself (read by provision.sh, preflight.sh and the data-writing scripts) --------
# Ampere A1 is arm64; provision refuses any other architecture for this profile.
OP_EXPECT_ARCH=aarch64
# SSH admits these, comma separated. `ubuntu` stays: it is the owner's login and its home
# holds the owner's other work. `deploy` (uid 2000) is the operator provision creates.
OP_SSH_ALLOW_USERS=deploy,ubuntu
# The uid that owns the api's data (/srv/open-persona/persona) and that the api and
# migrate containers run as. NOT 1000: on Oracle that is `ubuntu`, whose processes must
# not read tenant files. NOT 2000: that is the operator.
OP_DATA_UID=2001

# --- the block volume (ruling D3: 100 GB, Balanced, paravirtualized) -------------------------
# Formatted ext4 by provision ONLY when it carries no filesystem or partition signature,
# mounted by UUID at OP_DATA_MOUNT. It holds the data, the backups, Docker's data root and
# the swapfile; the boot volume keeps the OS and the owner's other work.
OP_DATA_DEVICE=/dev/oracleoci/oraclevdb
OP_DATA_MOUNT=/srv
OP_DOCKER_DATA_ROOT=/srv/docker
OP_SWAP_GB=4
# The nightly backup refuses to start with less free space than this under the backups.
OP_BACKUP_MIN_FREE_GB=20

# --- Oracle's image ---------------------------------------------------------------------------
# 1: hand the image's iptables rules (netfilter-persistent) to ufw, keeping the
# InstanceServices chain (bin/lib/oracle_firewall.sh).
OP_ORACLE_FIREWALL=1
# Units masked by provision, by name prefix, comma separated: rpcbind (listens on 111, no
# use here) and the unified-monitoring-agent (ruling D5). oracle-cloud-agent stays: it
# reports the metrics Oracle's idle-instance check reads.
OP_DISABLE_UNIT_PREFIXES=rpcbind,unified-monitoring-agent
