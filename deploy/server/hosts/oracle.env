# Host profile: the CORE host on Oracle Cloud Always Free (owner ruling 2026-11-07).
# VM.Standard.A1.Flex, Ampere arm64, 2 OCPU, 12 GB RAM, eu-frankfurt-1, Ubuntu 24.04.
#
# NOT secret, and tracked: plain OP_* settings only (scripts/tests/test_server_kit_hosts.py
# refuses anything else). bin/lib/compose.sh hands this file to `docker compose
# --env-file`, so every ${OP_...} in docker-compose.yml takes its value from here, the same
# for a restore, a backup and a deploy. Change a size here, then `bin/deploy.sh
# --skip-build` recreates the containers with it.
#
# The host is shared with the owner's other work (under /home/ubuntu). It is assumed idle
# for now (2026-11-07); if it starts using real memory, raise OP_HOST_RESERVED_GB and lower
# the limits below until the budget test passes again.

# --- the memory budget the limits must fit -------------------------------------------------
OP_HOST_RAM_GB=12
# Kept free of container limits: the OS, dockerd, oracle-cloud-agent, sshd, the page cache
# Postgres relies on, a build, and the owner's other work.
OP_HOST_RESERVED_GB=3.5

# --- postgres -------------------------------------------------------------------------------
OP_PG_MEM_LIMIT=3g
OP_PG_SHARED_BUFFERS=1GB
OP_PG_EFFECTIVE_CACHE_SIZE=3GB
OP_PG_MAINTENANCE_WORK_MEM=256MB
OP_PG_WORK_MEM=8MB
OP_PG_MAX_CONNECTIONS=60
OP_PG_MAX_WAL_SIZE=1GB

# --- api and caddy --------------------------------------------------------------------------
# The api holds the bge embedder, the reranker and the crisis encoder resident (about 2 to
# 2.5 GB with torch); one uvicorn worker, never more (packages/api/Dockerfile).
OP_API_MEM_LIMIT=4g
OP_CADDY_MEM_LIMIT=256m
