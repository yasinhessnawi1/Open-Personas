# Open Persona: the TLS edge on the VOICE host (Azure, Phase B; owner ruling 2026-11-07).
#
# The voice host's Caddy loads this file (docker-compose.voice.yml); the core host's loads
# Caddyfile. Same edge rules: Let's Encrypt over HTTP-01 (each name's DNS must point at
# the voice host; ACME_CA starts on STAGING), the admin API OFF, no access logs, and an
# error log without the request URI (LiveKit signaling carries its access token in the
# query string) or the Authorization and Cookie headers.

{
	admin off
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
	log default {
		output stderr
		format filter {
			request>uri delete
			request>headers>Authorization delete
			request>headers>Cookie delete
		}
	}
}

(edge) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# persona-voice: POST /v1/voice/token and GET /v1/voices, called by the browser, and the
# api's read aloud and dictation proxies (POST /v1/tts, POST /v1/stt). On one box the api
# reached voice on the internal network; with voice on its own host (Azure) the api's calls
# come through this edge.
#   * POST /v1/stt carries dictation audio: its cap sits above voice's own 10 MiB upload
#     limit (_STT_AUDIO_MAX_BYTES in persona_voice/http/app.py) plus multipart overhead.
#   * Everything else stays at 1 MB. FastAPI reads a body before it checks auth and voice
#     has no rate limit, so a large anonymous body to any route stalls the one voice event
#     loop (about 476 ms per 12 MB request); only the audio route needs the room.
voice.openpersonas.si {
	import edge
	handle /v1/stt {
		request_body {
			max_size 12MB
		}
		reverse_proxy 127.0.0.1:8001
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8001
	}
}

# Self-hosted LiveKit signaling (WebSocket). Media does NOT pass through Caddy: it goes
# straight to UDP 7882 (or TCP 7881) on the box. With LiveKit Cloud this site answers
# 502, which is harmless; keep the DNS record so switching modes needs no DNS change.
livekit.openpersonas.si {
	import edge
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:7880
}
