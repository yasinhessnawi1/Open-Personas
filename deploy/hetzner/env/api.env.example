# Open Persona on Hetzner: api-only settings (compose env_file, after common.env).
# TEMPLATE: tokens are explained in common.env.example. Never put a real value here.

# --- database (generated on the box; bin/restore.sh creates the roles) ---
# The cross-tenant engines (admin, job dispatch, JIT user provisioning): persona_platform,
# which bypasses RLS but is NOT a superuser and has DML only. The superuser DSN is in
# migrate.env, read only by the one-shot `migrate` service, never by the api.
DATABASE_URL=postgresql+psycopg://persona_platform:__GEN_PLATFORM_DB_PASSWORD__@postgres:5432/persona
# Request path: the RLS-enforced persona_app role. Without it every RLS policy is moot.
APP_DATABASE_URL=postgresql+psycopg://persona_app:__GEN_APP_DB_PASSWORD__@postgres:5432/persona

# --- auth ---
# The PROD Clerk instance's PEM. Confirm .env holds prod, not a *.clerk.accounts.dev key.
PERSONA_API_JWT_PUBLIC_KEY=__FROM_ENV__
# The web app's origin(s), comma separated, e.g. https://app.openpersonasai.com
PERSONA_API_CORS_ORIGINS=__OWNER__

# --- at-rest encryption: MUST be the exact production key, or every stored MCP credential
# becomes unreadable and every user has to reconnect. ---
MCP_CREDENTIAL_KEY=__FROM_ENV__

# --- tools ---
E2B_API_KEY=__FROM_ENV__
PERSONA_IMAGEGEN_PROVIDER=__FROM_ENV__
PERSONA_IMAGEGEN_MODEL=__FROM_ENV__
PERSONA_IMAGEGEN_MODELS=__FROM_ENV__
PERSONA_IMAGEGEN_API_KEY=__FROM_ENV__
PERSONA_MCP_OAUTH_REDIRECT_BASE_URL=__FROM_ENV__
PERSONA_MCP_OAUTH_GITHUB_CLIENT_ID=__FROM_ENV__
PERSONA_MCP_OAUTH_GITHUB_CLIENT_SECRET=__FROM_ENV__

# --- per-tenant MCP runtime: OFF (2026-10-23 ruling, pending the owner's confirmation) ---
# The runtime booted one Fly Machine per (tenant, server) through the Fly Machines API
# (persona_api/mcp/fly.py, Spec N6). Its Fly app was deleted on 2026-10-02, so there is
# nothing to call. FLY_API_TOKEN and PERSONA_MCP_RUNTIME_FLY_APP are deliberately ABSENT;
# the boot line reports the runtime "off". Users keep the built-in MCP surface. The
# replacement is a Docker runtime behind the same Protocol: later work, not this move.
PERSONA_ALLOW_PER_TENANT_MCP=0

# --- behaviour flags (.env; each was a Fly secret on the api, confirm the prod state) ---
PERSONA_API_IN_PROCESS_WORKER=__FROM_ENV__
PERSONA_API_WITHIN_RUNTIME_ORIGINATION=__FROM_ENV__
PERSONA_EVENT_TRIGGERS_ENABLED=__FROM_ENV__
# Initiative stays OFF: owner condition since 2026-09-26, turned back on only after a
# green A5-R-1 re-run. Not copied from .env on purpose.
PERSONA_INITIATIVE_ENABLED=false

# --- billing: Stripe TEST mode, as production ran (R9 2026-09-06). Going live is its own
# owner decision. The webhook endpoint stays https://api.openpersonasai.com/v1/billing/webhook.
PERSONA_BILLING_STRIPE_ENABLED=__FROM_ENV__
PERSONA_STRIPE_SECRET_KEY=__FROM_ENV__
PERSONA_STRIPE_PUBLISHABLE_KEY=__FROM_ENV__
PERSONA_STRIPE_WEBHOOK_SECRET=__FROM_ENV__
PERSONA_STRIPE_PRICE_PLUS=__FROM_ENV__
PERSONA_STRIPE_PRICE_PRO=__FROM_ENV__
PERSONA_STRIPE_PRICE_PACK_5=__FROM_ENV__
PERSONA_STRIPE_PRICE_PACK_10=__FROM_ENV__
PERSONA_STRIPE_PRICE_PACK_25=__FROM_ENV__
PERSONA_STRIPE_PRICE_PACK_50=__FROM_ENV__
PERSONA_STRIPE_CHECKOUT_SUCCESS_URL=__FROM_ENV__
PERSONA_STRIPE_CHECKOUT_CANCEL_URL=__FROM_ENV__
PERSONA_STRIPE_PORTAL_RETURN_URL=__FROM_ENV__

# --- connectors, hosted IN the api since the I1 fold (.env) ---
# Confirm each token is the PROD bot or app. A dev process polling the same Telegram bot
# token evicts the prod poller on every getUpdates.
PERSONA_CONNECTORS_JWT_PUBLIC_KEY=__FROM_ENV__
PERSONA_CONNECTORS_JWT_SECRET=__FROM_ENV__
PERSONA_CONNECTORS_JWT_JWKS_URL=__FROM_ENV__
PERSONA_CONNECTORS_TELEGRAM_BOT_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_TELEGRAM_BOT_USERNAME=__FROM_ENV__
PERSONA_CONNECTORS_DISCORD_BOT_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_DISCORD_OAUTH_CLIENT_ID=__FROM_ENV__
PERSONA_CONNECTORS_DISCORD_OAUTH_CLIENT_SECRET=__FROM_ENV__
PERSONA_CONNECTORS_DISCORD_OAUTH_REDIRECT_URI=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_BOT_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_APP_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_SIGNING_SECRET=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_OAUTH_CLIENT_ID=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_OAUTH_CLIENT_SECRET=__FROM_ENV__
PERSONA_CONNECTORS_SLACK_OAUTH_REDIRECT_URI=__FROM_ENV__
PERSONA_CONNECTORS_TWILIO_ACCOUNT_SID=__FROM_ENV__
PERSONA_CONNECTORS_TWILIO_AUTH_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_TWILIO_WEBHOOK_AUTH_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_TWILIO_SMS_FROM=__FROM_ENV__
PERSONA_CONNECTORS_TWILIO_WHATSAPP_FROM=__FROM_ENV__
PERSONA_CONNECTORS_POSTMARK_SERVER_TOKEN=__FROM_ENV__
PERSONA_CONNECTORS_POSTMARK_WEBHOOK_USERNAME=__FROM_ENV__
PERSONA_CONNECTORS_POSTMARK_WEBHOOK_PASSWORD=__FROM_ENV__
PERSONA_CONNECTORS_EMAIL_INBOUND_ADDRESS=__FROM_ENV__
