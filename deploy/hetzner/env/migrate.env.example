# Open Persona on Hetzner: the one-shot `migrate` service, and nothing else.
# TEMPLATE: tokens are explained in common.env.example. Never put a real value here.
#
# The ONLY place the superuser DSN lives. packages/api/release.py needs exactly this:
# alembic upgrade head, then the persona_app and persona_platform grants. No other
# service reads this file, so the long-running api never holds superuser credentials.
DATABASE_URL=postgresql+psycopg://persona:__GEN_POSTGRES_PASSWORD__@postgres:5432/persona
