# Open Persona on Hetzner: the postgres service (pgvector/pgvector:pg16).
# TEMPLATE: tokens are explained in common.env.example. Never put a real value here.
#
# The image creates the superuser role `persona` and the database `persona` on first boot
# of an empty volume. bin/restore.sh then creates persona_app with
# PERSONA_APP_DB_PASSWORD and persona_platform with PERSONA_PLATFORM_DB_PASSWORD. Every password is NEW: the Fly-era ones are gone with Fly.
POSTGRES_USER=persona
POSTGRES_DB=persona
POSTGRES_PASSWORD=__GEN_POSTGRES_PASSWORD__
PERSONA_APP_DB_PASSWORD=__GEN_APP_DB_PASSWORD__
PERSONA_PLATFORM_DB_PASSWORD=__GEN_PLATFORM_DB_PASSWORD__
