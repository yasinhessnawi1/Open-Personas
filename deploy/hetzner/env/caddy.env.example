# Open Persona on Hetzner: Caddy, the TLS edge.
# TEMPLATE: tokens are explained in common.env.example. Never put a real value here.

# Let's Encrypt contact for expiry and incident notices.
ACME_EMAIL=__OWNER__
# STAGING by default: its certificates are untrusted but its rate limits are generous, so
# trial runs cannot lock the real hostnames out for a week. RUNBOOK.md step 8 switches it
# to https://acme-v02.api.letsencrypt.org/directory once every name answers.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
