# Open Persona on Hetzner: settings BOTH the api and voice read (compose env_file).
#
# This is a TEMPLATE. render_env.py turns it into common.env on the owner's PC, outside
# the repo, and the real file lives on the box at /opt/open-persona/env/common.env
# (mode 0600). Never put a real value in this file.
#
# Value tokens (render_env.py and bin/fill_generated.sh resolve them):
#   __FROM_ENV__            copied from the owner's local .env, same name
#   __FROM_ENV:OTHER__      copied from the owner's local .env, name OTHER
#   __GITHUB_PRODUCTION__   one of the seven shared settings (R9-213). GitHub cannot read a
#                           secret back, so the owner supplies it, or confirms the .env
#                           value is the production one (render_env.py --chains-from-dotenv)
#   __OWNER__               only the owner can supply it
#   __GEN_<NAME>__          generated on the box by bin/fill_generated.sh
#   anything else           a fixed value, reviewed here
# Settings that are NOT secrets and never vary (paths, internal URLs, JWT algorithms) are
# set in docker-compose.yml `environment:` instead, so a stale env file cannot override them.

# --- the seven shared settings (GitHub Production environment, R9-213) ---
PERSONA_FRONTIER_MODELS=__GITHUB_PRODUCTION__
PERSONA_MID_MODELS=__GITHUB_PRODUCTION__
PERSONA_SMALL_MODELS=__GITHUB_PRODUCTION__
PERSONA_FREE_FRONTIER_MODELS=__GITHUB_PRODUCTION__
PERSONA_FREE_MID_MODELS=__GITHUB_PRODUCTION__
PERSONA_FREE_SMALL_MODELS=__GITHUB_PRODUCTION__
PERSONA_OPENROUTER_SUBSCRIPTION_MODE=__GITHUB_PRODUCTION__

# --- model provider credentials (.env) ---
PERSONA_OPENROUTER_API_KEY=__FROM_ENV__
PERSONA_OPENROUTER_BASE_URL=__FROM_ENV__
PERSONA_ANTHROPIC_API_KEY=__FROM_ENV__
PERSONA_DEEPSEEK_API_KEY=__FROM_ENV__
PERSONA_GROQ_API_KEY=__FROM_ENV__
PERSONA_NVIDIA_API_KEY=__FROM_ENV__
PERSONA_CLOUDFLARE_ACCOUNT_ID=__FROM_ENV__
PERSONA_CLOUDFLARE_API_KEY=__FROM_ENV__
# Core single-backend defaults (persona.config / persona.backends.config).
PERSONA_PROVIDER=__FROM_ENV__
PERSONA_MODEL=__FROM_ENV__
PERSONA_API_KEY=__FROM_ENV__

# --- web search (.env) ---
PERSONA_WEB_SEARCH_PROVIDER=__FROM_ENV__
PERSONA_WEB_SEARCH_API_KEY=__FROM_ENV__

# --- speech (.env). The api reads the TTS provider for the persona voice pick. ---
PERSONA_STT_PROVIDER=__FROM_ENV__
PERSONA_STT_MODEL=__FROM_ENV__
PERSONA_STT_API_KEY=__FROM_ENV__
PERSONA_GLADIA_API_KEY=__FROM_ENV__
PERSONA_TTS_PROVIDER=__FROM_ENV__
PERSONA_TTS_MODEL=__FROM_ENV__
PERSONA_TTS_API_KEY=__FROM_ENV__
PERSONA_TTS_VOICE_DEFAULT=__FROM_ENV__
PERSONA_ELEVENLABS_API_KEY=__FROM_ENV__

# --- recall and billing (.env; both were Fly secrets on the api, confirm the prod state) ---
PERSONA_RECALL_UNIFIED_ENABLED=__FROM_ENV__
PERSONA_RECALL_RERANK_ENABLED=__FROM_ENV__
PERSONA_CREDIT_MARKUP=__FROM_ENV__
