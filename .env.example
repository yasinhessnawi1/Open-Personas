# ---- Voice service (persona_voice.config) ----
#PERSONA_VOICE_AGENT_INPROCESS=false
# Where the voice service's durable records land (R9-188): the typed-store writes
# a spoken turn makes, the session lifecycle record, and the per-turn latency log.
# Mirrors the api pair above. "jsonl" writes per-persona files under the root;
# "postgres" writes the shared store_audit_events table on the call's own RLS
# engine (and degrades to jsonl with no database handle). An EMPTY root means the
# system temp dir, which is swept: a cloud deployment whose backend resolves to
# jsonl with a temp-dir root refuses to start and names both variables. Community
# is allowed it and says so once.
#PERSONA_VOICE_AUDIT_BACKEND=jsonl
#PERSONA_VOICE_AUDIT_ROOT=
#PERSONA_VOICE_COMMUNITY_OWNER_EMAIL=local@localhost
