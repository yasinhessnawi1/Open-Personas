#PERSONA_API_AUDIT_ROOT=./.persona_audit
#PERSONA_API_AUTHORING_TIER=frontier
#PERSONA_API_AVATAR_GEN_TIMEOUT_S=25.0
# Code default: your home directory plus /.persona (config.py:166,
# Path.home() / ".persona"). The cluster lives in <dir>/pg16 (D-K10-10).
#PERSONA_API_COMMUNITY_MANAGED_DB_DIR=~/.persona
#PERSONA_API_COMMUNITY_OWNER_EMAIL=local@localhost
#PERSONA_API_COMMUNITY_OWNER_ID=local-owner
#PERSONA_API_CORS_ORIGINS=http://localhost:3000
#PERSONA_API_CREDITS_PER_TURN=1
#PERSONA_API_DB_POOL_SIZE=5
# Spec I1: host the connector transports (Telegram / Discord / Slack / WhatsApp /
# SMS / email) INSIDE the api process instead of on their own machine, reusing the
# api's engines and model stack. Default OFF, and no edition turns it on by itself.
# Turning it on while the standalone connectors app is still running would put two
# consumers on one Slack socket / Telegram poller / Discord token and double-deliver
# every message, so flip it only at the point the cutover runbook says to
# (docs/ops/connectors_fold_cutover.md). Rollback is this one variable.
#PERSONA_API_EMBED_CONNECTORS=false
# May a persona SPEAK FIRST on a connector, or only reply there? ON by default: a task's
# progress, an approval ask and a failure account reach the chat the work was handed over
# in. Set it to false to stop personas starting conversations on Telegram / Discord /
# Slack / WhatsApp / SMS / email WITHOUT taking the connectors down: replies keep working
# exactly as before and originated messages go to the web app only. That is the reason
# this switch exists separately from PERSONA_API_EMBED_CONNECTORS, which turns off the
# whole channel, replies included.
#PERSONA_API_CONNECTOR_ORIGINATION_ENABLED=true
#PERSONA_API_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
#PERSONA_API_EPISODIC_SUMMARY_TIER=small
#PERSONA_API_IN_PROCESS_WORKER=
