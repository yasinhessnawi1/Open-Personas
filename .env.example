#PERSONA_SANDBOX_SETUP_CAP_S=120.0
# Accepted older aliases for the same two caps. The two names above are canonical
# and win if both are set; these stay readable so a deployment that already holds
# a secret under the old spelling keeps working.
#PERSONA_SANDBOX_WALLCLOCK_EXEC_S=30.0
#PERSONA_SANDBOX_WALLCLOCK_SETUP_S=120.0

# ---- Connector service (C-track) ----
#PERSONA_CONNECTORS_COMMUNITY_DB_PATH=./persona_community.db
#PERSONA_CONNECTORS_COMMUNITY_MEMORY_PATH=./persona_community_memory
#PERSONA_CONNECTORS_COMMUNITY_OWNER_EMAIL=local@localhost
#PERSONA_CONNECTORS_COMMUNITY_OWNER_ID=local-owner
#PERSONA_CONNECTORS_DB_POOL_SIZE=5
#PERSONA_CONNECTORS_DISCORD_API_BASE_URL=https://discord.com/api/v10
#PERSONA_CONNECTORS_DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json
#PERSONA_CONNECTORS_EMAIL_INBOUND_ADDRESS=
#PERSONA_CONNECTORS_EMAIL_LINK_TOKEN_TTL_MINUTES=15
#PERSONA_CONNECTORS_JWT_ALGORITHMS=HS256
#PERSONA_CONNECTORS_JWT_AUDIENCE=
# R9-062: opt-in JWKS verification (kid-matched, survives key rotation, works across
# Clerk instances). Set to a JWKS document URL (e.g. Clerk's
# https://<instance>.clerk.accounts.dev/.well-known/jwks.json) to use make_jwks_verifier
# instead of the static JWT_PUBLIC_KEY below. Leave unset to keep the static verifier.
#PERSONA_CONNECTORS_JWT_JWKS_URL=
#PERSONA_CONNECTORS_JWT_PUBLIC_KEY=
#PERSONA_CONNECTORS_JWT_SECRET=
#PERSONA_CONNECTORS_PHONE_LINK_TOKEN_TTL_MINUTES=10
#PERSONA_CONNECTORS_POSTMARK_API_BASE_URL=https://api.postmarkapp.com
#PERSONA_CONNECTORS_POSTMARK_SERVER_TOKEN=
#PERSONA_CONNECTORS_POSTMARK_WEBHOOK_PASSWORD=
#PERSONA_CONNECTORS_POSTMARK_WEBHOOK_USERNAME=
#PERSONA_CONNECTORS_SLACK_API_BASE_URL=https://slack.com/api
#PERSONA_CONNECTORS_SMS_MAX_SEGMENTS=3
# What ONE outbound SMS segment costs you, in CENTS. Unset means no price is known, and
# then nobody is billed for the segments and the service says so in a WARNING per message
# rather than guessing: Twilio's per-segment price varies by destination country and by
# account, and a guessed price overcharges a real person. Look yours up on the Twilio
# pricing page for the destinations you actually send to (US long-code outbound was 0.83
# at the time of writing). Needs the status callback below to be set as well.
#PERSONA_CONNECTORS_SMS_PRICE_PER_SEGMENT_CENTS=
#PERSONA_CONNECTORS_TELEGRAM_API_BASE_URL=https://api.telegram.org
#PERSONA_CONNECTORS_TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
#PERSONA_CONNECTORS_TELEGRAM_LONGPOLL_TIMEOUT_SECONDS=30
#PERSONA_CONNECTORS_TWILIO_ACCOUNT_SID=
#PERSONA_CONNECTORS_TWILIO_API_BASE_URL=https://api.twilio.com
#PERSONA_CONNECTORS_TWILIO_AUTH_TOKEN=
#PERSONA_CONNECTORS_TWILIO_SMS_FROM=
# The PUBLIC base URL Twilio posts delivery status callbacks to, e.g.
# https://connectors.example.com, and each channel appends its own /{platform}/status path.
# Unset sends no StatusCallback with the message, which leaves delivery outcomes and the
# per-segment SMS cost to whatever the Twilio console has configured on the number.
#PERSONA_CONNECTORS_TWILIO_STATUS_CALLBACK_BASE_URL=
#PERSONA_CONNECTORS_TWILIO_WEBHOOK_AUTH_TOKEN=
#PERSONA_CONNECTORS_TWILIO_WHATSAPP_FROM=
#PERSONA_CONNECTORS_WHATSAPP_REENGAGEMENT_TEMPLATE_SID=

# ---- Miscellaneous (read directly from os.environ) ----
#PERSONA_API_PORT=
#PERSONA_API_RELOAD=false
#PERSONA_APP_DB_PASSWORD=
#PERSONA_DEV_CHEAP_TIERS=
#SSL_CERT_FILE=

# --- Dynamic chat titles (R9-020) ---
# The tier conversation titles are generated on — the first-turn auto-title AND
# the title_refresh background job (re-titles at message thresholds 4/10/24/50/
# 100 so the title keeps describing the WHOLE chat). mid by default (the P9
# "title" surface row); small is NOT recommended (it echoed the titling
# instruction — the R4 first-words-fallback root). Set frontier for maximum
# title quality.
# PERSONA_API_TITLE_TIER=mid

# --- Spec M2 (unified OpenRouter-sourced cost) -------------------------------
# Catalog freshness window for the OpenRouter model catalog (D-M2-6). Billing-
# grade estimates re-fetch the catalog when older than this many seconds —
# ALWAYS off the turn path (the /v1/models request path or the api lifespan
# refresh task; a failed refresh keeps serving the stale copy). <= 0 disables
# the TTL (pre-M2 process-lifetime cache). Default 21600 (6 h).
#PERSONA_OPENROUTER_CATALOG_TTL_S=21600
# Proportional chat-turn billing (D-M2-5): each completed turn charges
# max(PERSONA_API_CREDITS_PER_TURN, ceil(recorded cost_cents)) at 1 credit =
# 1 cent; unpriced/legacy turns charge the flat floor. false = the pre-M2
# flat 1-credit turn (the rollback hatch). Default true.
#PERSONA_API_PROPORTIONAL_CREDITS=true
# Spec M2 review (reviewer defense-in-depth, adjudicated TAKE): a hard ceiling
# on the per-turn PROPORTIONAL charge — a resolver/unit-scale pricing bug must
# never bill a single turn thousands of credits. Clamps ONLY the charged
# amount; the persisted TurnLog/UsageEntry keeps the verbatim true cost
# (basis honesty is untouchable). <= 0 disables the ceiling. Default 500.
#PERSONA_API_MAX_TURN_CREDITS=500

# --- Turn-into-file (R9-025b) ---
# The tier the "Turn into file" message-action extraction pass runs on (mid —
# a substance-extraction + format-decision call warrants the same quality bar
# as titles, not the cheap background-summary tier). Feature itself needs no
# separate on/off flag: it's gated on a model backend AND the hosted sandbox
# pool (E2B_API_KEY) both being configured (persona_api.jobs.handlers.
# file_extract.file_extract_queue_ready) — unset E2B_API_KEY hides/disables
# the action, same graceful-absence shape as the sandbox pool everywhere else.
# PERSONA_API_FILE_EXTRACT_TIER=mid

# --- Model-load robustness (R9-027) ---
# Hard deadline (seconds) on the crisis-encoder boot warm-up — a hang-guard,
# not a latency SLA. A cold HF cache makes the load a network dependency, and
# huggingface_hub's own bounds are per-request only (10 s socket timeouts, 5
# exponential-backoff retries per file — NO aggregate bound). On deadline the
# boot logs one WARNING and serves lexical-only (fail-soft→R0); the load
# continues on a daemon thread (never joined at shutdown) and encoder verdicts
# resume automatically if it completes. <= 0 disables the deadline (the
# pre-R9-027 unbounded wait). Default 120.
#PERSONA_CRISIS_WARMUP_DEADLINE_S=120

# --- Spec N7 close-out addendum: MCP wiring recipes cross-reference ---
# The MCP mechanism env vars (PERSONA_MCP_SERVERS, PERSONA_MCP_BUILTIN_ENABLED,
# PERSONA_DOCKER_MCP_GATEWAY_URL/TOKEN, PERSONA_MCP_RUNTIME_FLY_APP/FLY_API_TOKEN,
# PERSONA_MCP_MIRROR_PATH, PERSONA_SKILL_MIRROR_PATH, the OAuth GitHub triplet) are
# already documented in full above, near their sections. Two things N7's close-out
# (T4b) adds on top:
#
# 1. PREREQUISITE the existing PERSONA_MCP_RUNTIME_FLY_APP doc doesn't state: that
#    Fly app does NOT exist anywhere in this repo's tooling yet — no fly.toml, no CI
#    deploy job (deploy.yml deploys exactly 3 apps: api/voice/livekit). Provision it
#    FIRST, before setting PERSONA_MCP_RUNTIME_FLY_APP/FLY_API_TOKEN/PERSONA_ALLOW_PER_TENANT_MCP:
#      flyctl apps create <your-mcp-runtime-app-name>
#      flyctl tokens create deploy -a <your-mcp-runtime-app-name>   # scope to that app only
#
# 2. The hosted deploy no longer needs PERSONA_MCP_MIRROR_PATH / PERSONA_SKILL_MIRROR_PATH
#    set here by hand — packages/api/fly.toml [env] now sets both directly (on the
#    already-mounted persona_audit volume), so a Fly deploy gets a persistent catalog
#    mirror out of the box. This .env.example documentation stays for local/dev/community
#    runs, where the two vars remain unset by default (bundled snapshot, N2-D-1).
