# Copy to .env and fill in your values. Never commit .env.
#
# Spec 02 (model backends): persona-core reads PERSONA_PROVIDER + PERSONA_API_KEY
# + PERSONA_MODEL (+ optional PERSONA_BASE_URL) for the default backend.
# Optional per-tier overrides land in spec 05; the keys below reserve the env var
# names so the wiring is consistent across specs.

# ============================================================================
# Open-core edition (Spec 33) — the master switch (api + web + voice read it)
# ============================================================================
# PERSONA_EDITION=community (the default) runs the whole product locally with
# NO auth wall, NO credits, and NO Postgres/Docker — persistence is a SQLite
# file + Chroma. You only need a model API key (above). Leave it unset for the
# zero-infra self-host.
#
# PERSONA_EDITION=cloud is the commercial hosting path: Clerk auth, multi-tenant
# Postgres RLS, and metered credits (set DATABASE_URL/APP_DATABASE_URL + the JWT
# + Clerk vars below). The owner's deploy MUST set this — see MAINTENANCE.md.
# PERSONA_EDITION=community
#
# Community persistence paths (optional overrides; sensible cwd defaults):
# PERSONA_API_COMMUNITY_DB_PATH=./.persona_community.db
# PERSONA_API_COMMUNITY_MEMORY_PATH=./.persona_chroma
#
# Safety guard (D-33-4): community is single-user-local by intent. The API
# REFUSES to start no-auth on a non-loopback bind unless you explicitly opt in.
# Only set this if you understand the instance will be OPEN + UNAUTHENTICATED.
# PERSONA_ALLOW_PUBLIC_NOAUTH=1
# PERSONA_API_HOST=127.0.0.1

# --- Default backend (used by CLI and as the frontier tier in spec 05) ---
PERSONA_PROVIDER=anthropic
PERSONA_MODEL=claude-sonnet-4-6
PERSONA_API_KEY=sk-ant-...

# Optional: override the provider's default base URL (proxy, self-hosted, or a
# new provider not in the OpenAI-compat table).
# PERSONA_BASE_URL=https://my-proxy.example/v1/

# Optional: per-call HTTP timeout (seconds). Default 60. (D-02-3)
# PERSONA_REQUEST_TIMEOUT_S=60

# Optional: the opt-out for loading this .env into os.environ at startup (D-02-4).
# Set 0 / false / no / off and persona.local_env.load_local_env skips the file, so
# a deployment that exports every var itself is never second-guessed by a stray
# checkout .env. Unset or any other value loads it, which is the default. Library
# code never autoloads .env at all; only the *.dev entrypoints call the loader.
# The gate covers the FILE only. The dev-derived vars (APP_DATABASE_URL and
# friends) are still derived from whatever you did export.
# PERSONA_DOTENV_LOAD=1

# --- Per-provider keys (used when a tier picks a non-default provider) ---
# (Provider-key env vars are read by spec 05's router, not by spec 02.)
# PERSONA_ANTHROPIC_API_KEY=sk-ant-...
# PERSONA_OPENAI_API_KEY=sk-...
# PERSONA_DEEPSEEK_API_KEY=sk-...
# PERSONA_GROQ_API_KEY=gsk_...
# PERSONA_TOGETHER_API_KEY=...
# PERSONA_OLLAMA_BASE_URL=http://localhost:11434
#
# Every provider also takes a PERSONA_<PROVIDER>_BASE_URL override, read at
# resolution time (packages/core/src/persona/backends/credentials.py). Point one
# at a corporate proxy, a gateway or a self-hosted endpoint and the SDK for that
# provider talks to it instead. Unset = the built-in default shown here.
# PERSONA_ANTHROPIC_BASE_URL=https://api.anthropic.com
# PERSONA_OPENAI_BASE_URL=https://api.openai.com/v1/
# PERSONA_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/
# PERSONA_GROQ_BASE_URL=https://api.groq.com/openai/v1/
# PERSONA_TOGETHER_BASE_URL=https://api.together.xyz/v1/
#
# Cloudflare Workers AI — CHAT path (distinct from the imagegen-scoped key in
# the Spec 15 section below; both share the same Cloudflare account id).
# PERSONA_CLOUDFLARE_API_KEY=          # obtain from the CF dashboard (Workers AI Read+Edit)
# PERSONA_CLOUDFLARE_ACCOUNT_ID=       # 32-char hex; required with the key above when provider=cloudflare
# PERSONA_CLOUDFLARE_BASE_URL=         # optional override of the assembled chat base URL (derived by default)

# --- NVIDIA (Spec 20) ---
# PERSONA_NVIDIA_API_KEY=nvapi-...
# PERSONA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/   # optional override
#
# NOTE: NVIDIA's hosted catalog at integrate.api.nvidia.com is "for prototyping,
# research, development and testing purposes only" per NIM ToS. Production-tier
# traffic (real end-users / business transactions) requires NVIDIA AI Enterprise
# (~$4,500/GPU/year or ~$1/GPU-hour cloud) OR routing production traffic through
# a different provider for production traffic (set as primary in PERSONA_<TIER>_MODELS,
# demote NVIDIA to fallback-only slot).

# --- OpenRouter (Spec 22) ---
# Single key unlocks 300+ aggregated models (Anthropic, OpenAI, Meta, Google,
# DeepSeek, NVIDIA, ...) via one OpenAI-compatible surface. Native model names
# are already <provider>/<model> slash-format, so OpenRouter slots into the
# PERSONA_<TIER>_MODELS cross-provider lists below unchanged (D-22-3 + D-20-13).
# PERSONA_OPENROUTER_API_KEY=sk-or-v1-...
# PERSONA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/   # optional override
#
# Subscription mode auto-detects at startup via GET /api/v1/key (D-22-3): the
# key's is_free_tier flag selects free-mode (only :free models usable) vs
# paid-mode (full catalog). Force it (skip the probe) with:
# PERSONA_OPENROUTER_SUBSCRIPTION_MODE=free   # or "paid" (D-22-7 escape hatch)
# Read by the api, the connector service AND voice (R9-224): set the same value on
# every app, because each process probes on its own and a failed probe means free.
# An invalid value stops the api and the connector service at boot; voice logs ERROR
# and applies no filter.
#
# The free-model request ceiling, per UTC day and ACCOUNT-WIDE: shared by every
# free-plan user's turn AND every background job that runs on a free chain. The two
# values OpenRouter uses are 50/day under $10 of lifetime credits and 1000/day at or
# above it; ours is the latter, since credits were bought. The api counts free-model
# requests against this and logs at 25/50/75 percent (INFO) and 90 percent (WARNING),
# once each per UTC day, so the moment to move background jobs off the free chain is
# seen coming rather than discovered as afternoon failures (R9-179 item 3). Set 0 to
# disable the meter (a deployment not on a capped free plan).
#PERSONA_OPENROUTER_FREE_DAILY_CAP=1000
#
# OpenRouter :free examples (verified 2026-06-10; the 2025 roster — DeepSeek-R1,
# Llama-4, Qwen3-235B, Gemini-Flash :free — is DELISTED). Free-tier limits:
# 20 req/min; 50 req/day (<$10 lifetime credits) or 1000/day (>=$10). Account-wide,
# no SLA, roster churns without notice — fallback/dev slots only; pair with a
# non-OpenRouter primary (e.g. NVIDIA NIM) for the daily-cap mitigation (D-22-2 + F-position).
# PERSONA_FRONTIER_MODELS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# PERSONA_MID_MODELS=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/openai/gpt-oss-120b:free
# PERSONA_MID_MODELS=openrouter/google/gemma-4-31b-it:free   # vision (image+video) + tools alternative
# PERSONA_SMALL_MODELS=openrouter/nvidia/nemotron-nano-9b-v2:free
#
# Image generation (paid-mode only; zero :free image models exist on OpenRouter):
# PERSONA_IMAGEGEN_MODELS=openrouter/google/gemini-2.5-flash-image   # ~$0.039/image (D-22-8 + acceptance #2)

# --- Intelligent routing (Spec 23) ---
# Metadata-driven model selection WITHIN a tier (cost / quality / latency /
# capability) is configured PER-PERSONA in the persona YAML, NOT via env vars —
# it is opt-in (default off) so existing personas route unchanged:
#
#   routing:
#     intelligent:
#       enabled: true                 # default false (v0.2 opt-in)
#       weights: { cost: 0.4, quality: 0.5, latency: 0.1 }   # capability is a hard gate
#       fallback_to_rule_based_on_miss: true                 # degrade on metadata miss
#     budget:
#       max_cents_per_turn: 5          # HARD cap → BudgetExceededError if nothing fits
#       max_cents_per_session: 100     # SOFT cap → re-weights toward cost as it nears
#       # max_cents_per_day: 500       # NOT YET ENFORCED — setting it FAILS LOUD at
#       #                              # startup (no cross-session store; D-23-7).
#
# The only env lever Spec 23 adds is the metadata source: the static per-provider
# tables in persona-core are always available (authoritative, offline); setting
# PERSONA_OPENROUTER_API_KEY (above) additionally enables the OpenRouter catalog
# as the broad-coverage fallback for models not in the static tables
# (D-23-X-resolver-precedence: static wins on overlap).
#
# Spec M1 — per-persona model selection routes the chosen model via OpenRouter:
# PERSONA_OPENROUTER_API_KEY=

# --- Tier overrides (spec 05 router; read by TierRegistry) ---
# The runtime routes each turn to frontier / mid / small (architecture §5.3).
# Fallback (D-05-3): an unconfigured tier falls back small → mid → frontier.
# If NONE of the tier triples below are set, the registry builds a single
# backend from PERSONA_PROVIDER/PERSONA_MODEL/PERSONA_API_KEY above and serves
# it for all three tiers. If nothing resolves, TierNotConfiguredError (fail-fast).
PERSONA_FRONTIER_PROVIDER=anthropic
PERSONA_FRONTIER_MODEL=claude-sonnet-4-6
PERSONA_FRONTIER_API_KEY=sk-ant-...

PERSONA_MID_PROVIDER=deepseek
PERSONA_MID_MODEL=deepseek-chat
PERSONA_MID_API_KEY=sk-...

PERSONA_SMALL_PROVIDER=groq
PERSONA_SMALL_MODEL=llama-3.1-8b-instant
PERSONA_SMALL_API_KEY=gsk_...

# --- Cross-provider tier MODELS lists (Spec 20; D-20-13 + D-20-17) ---
# Optional. When set, takes precedence over the per-tier PROVIDER+MODEL+API_KEY
# triplet above (case (c) emits INFO log; case (b) preserves backward-compat
# single-backend fast path).
#
# Format: <provider>/<model>,<provider>/<model>,...   (slash-separated; comma-CSV)
# Per-entry credentials resolved via PERSONA_<PROVIDER>_API_KEY +
# PERSONA_<PROVIDER>_BASE_URL (the per-provider block above).
#
# `local` and `ollama` are NOT permitted in MODELS lists (D-20-18 — use
# the single-backend fast path via PERSONA_<TIER>_PROVIDER instead).
#
# Examples:
# PERSONA_FRONTIER_MODELS=nvidia/nemotron-3-super-120b-a12b,anthropic/claude-sonnet-4-6,openai/gpt-4o
# PERSONA_MID_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,deepseek/deepseek-chat
# PERSONA_SMALL_MODELS=groq/llama-3.1-8b-instant,nvidia/llama-3.3-nemotron-super-49b-v1.5
# PERSONA_IMAGEGEN_MODELS=nvidia/flux.2-klein-4b,fal/flux-1.1-pro,openai/gpt-image-1
#
# When BOTH PERSONA_<TIER>_MODELS and PERSONA_<TIER>_PROVIDER+MODEL+API_KEY
# are set, MODELS wins and an INFO log identifies the ignored triplet vars
# (D-20-17 case (c) — operator-mid-migration aid).
#
# --- Spec M4 plans — the FREE-tier model set (T1c; D-M4-4) ---
# The plan catalog (Free/Plus/Pro prices + allowances + the plan→model-set
# mapping) lives in CODE (persona.billing.plans, owner-locked Phase-4 numbers) —
# NOT here. These env vars supply the actual model strings the Free plan's
# model-set references: FREE-ONLY models (mid + OpenRouter `:free`) with NO paid
# fallback (a Free user must never reach a paid model — T5 enforces this at
# backend construction). Position 0 = primary. Paid plans (Plus/Pro) use the
# PERSONA_FRONTIER_MODELS / PERSONA_MID_MODELS tiers above (kimi-k3→sonnet /
# kimi-k2-0905→gpt-oss-120b→sonnet). Owner sets these at go-live.
# PERSONA_FREE_FRONTIER_MODELS=openrouter/<free-chat-model>:free
# PERSONA_FREE_MID_MODELS=openrouter/<free-voice-model>:free
# Optional: the free small tier (background LLM). Unset, `small` falls back
# mid → frontier WITHIN the free registry (never a paid model).
# PERSONA_FREE_SMALL_MODELS=
#
# The free registry is built by the same code path as the paid one, so each free
# tier ALSO reads the eight router-metadata names documented below, under its own
# PERSONA_FREE_<TIER>_ prefix (tier.py:733,744 call the same reader). Same
# all-or-nothing rule: miss one of the six required and that free tier routes on
# the heuristic router. No code default for the six; unset means no metadata.
# PERSONA_FREE_FRONTIER_COST_INPUT_PER_1K=
# PERSONA_FREE_FRONTIER_COST_OUTPUT_PER_1K=
# PERSONA_FREE_FRONTIER_FIRST_TOKEN_LATENCY_MS=
# PERSONA_FREE_FRONTIER_THROUGHPUT_TOKENS_PER_SEC=
# PERSONA_FREE_FRONTIER_CONTEXT_WINDOW=
# PERSONA_FREE_FRONTIER_TOOL_STRENGTH=
# PERSONA_FREE_FRONTIER_REASONING_CAPABLE=false      # default false
# PERSONA_FREE_FRONTIER_COST_VERIFIED_AT_DEPLOY=true # default true
# PERSONA_FREE_MID_COST_INPUT_PER_1K=
# PERSONA_FREE_MID_COST_OUTPUT_PER_1K=
# PERSONA_FREE_MID_FIRST_TOKEN_LATENCY_MS=
# PERSONA_FREE_MID_THROUGHPUT_TOKENS_PER_SEC=
# PERSONA_FREE_MID_CONTEXT_WINDOW=
# PERSONA_FREE_MID_TOOL_STRENGTH=
# PERSONA_FREE_MID_REASONING_CAPABLE=false           # default false
# PERSONA_FREE_MID_COST_VERIFIED_AT_DEPLOY=true      # default true
# PERSONA_FREE_SMALL_COST_INPUT_PER_1K=
# PERSONA_FREE_SMALL_COST_OUTPUT_PER_1K=
# PERSONA_FREE_SMALL_FIRST_TOKEN_LATENCY_MS=
# PERSONA_FREE_SMALL_THROUGHPUT_TOKENS_PER_SEC=
# PERSONA_FREE_SMALL_CONTEXT_WINDOW=
# PERSONA_FREE_SMALL_TOOL_STRENGTH=
# PERSONA_FREE_SMALL_REASONING_CAPABLE=false         # default false
# PERSONA_FREE_SMALL_COST_VERIFIED_AT_DEPLOY=true    # default true

# --- Routing policy (Spec P9; P9-D-2) ---
# Surface→tier is a deliberate policy (chat/authoring=frontier, voice=mid the
# latency tier, background=small, recognition=mid) — not user-tuned. The one
# env knob: the tier the A4/A8 intent interpreters (standing-intent/amendment/
# steering/reschedule) run on. mid minimum; set frontier for maximum intent
# reliability. Small is NOT recommended (the R4 confabulation root).
# PERSONA_API_RECOGNITION_TIER=mid
#
# Spec-23 intelligent (model-within-tier) routing + budget scoring is DORMANT
# by default (P9-D-4): the global gate below is consulted BEFORE any per-persona
# flag. Re-enable prerequisite: repopulate the model metadata for the deployed
# models first, or every pick silently degrades to rule-based slot-0.
# PERSONA_ROUTING_INTELLIGENT_ENABLED=false

# --- Per-tier router metadata (Spec 18 T04; Spec 20 T14 reasoning-capable) ---
# Optional. All six REQUIRED fields below must be set together for the
# TierRegistry to populate TierMetadata (UnifiedRouter Layer 2 reads it).
# Partial sets fall back to None (HeuristicRouter still routes the tier).
#
# All or nothing, and silent: miss ONE of the six required keys for a tier and
# that tier's metadata is None. No error, no warning, no startup failure. The
# tier just routes on the heuristic router from then on. So an operator who
# fills in frontier and stops has quietly turned intelligent routing off for
# mid and small. Read at packages/runtime/src/persona_runtime/tier.py:425-445.
#
# EVERY tier below takes the same eight names: frontier, mid and small, plus
# the three PERSONA_FREE_* tiers further down, which go through the same reader.
#
# # Required (set together):
# PERSONA_FRONTIER_COST_INPUT_PER_1K=1.5             # cents per 1k input tokens
# PERSONA_FRONTIER_COST_OUTPUT_PER_1K=7.5            # cents per 1k output tokens
# PERSONA_FRONTIER_FIRST_TOKEN_LATENCY_MS=600        # ms; EWMA-replaced after warm-up
# PERSONA_FRONTIER_THROUGHPUT_TOKENS_PER_SEC=30      # post-first-token throughput
# PERSONA_FRONTIER_CONTEXT_WINDOW=1000000            # tokens
# PERSONA_FRONTIER_TOOL_STRENGTH=strong              # weak | medium | strong
#
# # Optional (Spec 20 T14 additive):
# PERSONA_FRONTIER_REASONING_CAPABLE=true            # D-18-5 quality-proxy boost
#                                                     # on hard turns (default false)
# PERSONA_FRONTIER_COST_VERIFIED_AT_DEPLOY=false     # D-13-3 — set false when costs
#                                                     # are best-estimate (e.g., NVIDIA
#                                                     # hosted catalog — no public
#                                                     # $/Mtok per R-20-4). Default true.
#
# # The mid tier. Same six required, same two optional, same silent all-or-nothing.
# PERSONA_MID_COST_INPUT_PER_1K=
# PERSONA_MID_COST_OUTPUT_PER_1K=
# PERSONA_MID_FIRST_TOKEN_LATENCY_MS=
# PERSONA_MID_THROUGHPUT_TOKENS_PER_SEC=
# PERSONA_MID_CONTEXT_WINDOW=
# PERSONA_MID_TOOL_STRENGTH=
# PERSONA_MID_REASONING_CAPABLE=false                # default false
# PERSONA_MID_COST_VERIFIED_AT_DEPLOY=true           # default true
#
# # The small tier.
# PERSONA_SMALL_COST_INPUT_PER_1K=
# PERSONA_SMALL_COST_OUTPUT_PER_1K=
# PERSONA_SMALL_FIRST_TOKEN_LATENCY_MS=
# PERSONA_SMALL_THROUGHPUT_TOKENS_PER_SEC=
# PERSONA_SMALL_CONTEXT_WINDOW=
# PERSONA_SMALL_TOOL_STRENGTH=
# PERSONA_SMALL_REASONING_CAPABLE=false              # default false
# PERSONA_SMALL_COST_VERIFIED_AT_DEPLOY=true         # default true
#
# The six required keys have NO code default: unset means the tier has no
# metadata. The two optional ones default to false and true respectively.

# Optional: where the runtime writes per-turn TurnLog JSONL (D-05-10).
# Defaults to <PERSONA_CHROMA_PATH>/turnlogs/<conversation_id>.jsonl (mirrors the
# audit-log path convention). max_tool_rounds is a constructor default (5);
# no env knob in v0.1 (D-05-11). Likewise the agentic loop's max_steps is a
# constructor default (20); no env knob in v0.1 (spec 06, D-06-7).
# PERSONA_TURNLOG_PATH=.chroma/turnlogs/

# Spec 25 T21 (§2.9 RISKY half) — refusal auto-retry guardrail. DEFAULT-OFF.
# When the model REFUSES a tool it actually has (e.g. "I can't generate images"
# while generate_image is wired), the turn loop can inject ONE corrective system
# message ("You DO have the X tool…") and re-generate once. OFF by default —
# the runtime only DETECTS + records refusals (TurnLog.tool_refusal_detected)
# unless this is explicitly armed. Set to 1/true/yes/on to enable; logs
# TurnLog.refusal_retry_engaged per turn. Experimental: the corrected text
# streams after the refusal (visible self-correction).
# PERSONA_REFUSAL_RETRY_ENABLED=false

# --- HF local backend (only with persona-core[local] extras) ---
# PERSONA_LOCAL_MODEL_ID=google/gemma-2-9b-it
# PERSONA_LOCAL_QUANTIZATION=4bit          # 4bit | 8bit | none
# PERSONA_LOCAL_DEVICE=auto                # auto | cuda | mps | cpu

# --- ChromaDB (local dev) ---
PERSONA_CHROMA_PATH=.chroma/

# --- Which embedder the CLI builds (Spec K13) ---
# sentence-transformers (default) is the real one: bge-small-en-v1.5, 384 dimensions, and
# about a hundred seconds to load on a cold cache, paid inside the first write.
# hash is a deterministic stand-in that starts instantly and TURNS SEMANTIC SEARCH OFF.
# Writing, reading by id, listing, history, rollback and forget all stay exact; searching
# returns arbitrary results and does not error while it does, so the CLI prints a notice
# whenever this is set. Useful when you only ever write and read memories back by id.
# Local and CLI only: the hosted API composes its own embedder and ignores this, because a
# hosted store must never silently stop searching.
# PERSONA_EMBEDDER=sentence-transformers

# --- Postgres (hosted) ---
# Sync psycopg3 dialect (D-07-1): the MemoryStore protocol is synchronous, so
# the persona-core Postgres transport uses sync psycopg3. The spec-08 API may
# add its own async engine separately.
# Host port the docker-compose Postgres binds (container side is always 5432).
# Defaults to 5432; override (e.g. 5436) if another Postgres already owns 5432.
# Keep DATABASE_URL's host port in sync with this value.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://persona:persona@localhost:5432/persona

# --- persona repair (Spec K13) ---
# Which store `persona repair` checks for broken version chains. Unset (the default) means
# the local ChromaDB store at PERSONA_CHROMA_PATH, which is what a community or CLI user has.
# Set it to a Postgres DSN to check a hosted or self-hosted database instead; the equivalent
# --database-url flag wins over this. The command only ever moves version pointers, so it
# needs no embedding model and loads none, and without --apply it changes nothing at all.
# PERSONA_REPAIR_DATABASE_URL=

# --- Tools (spec 03) ---
# Web search provider — Brave (default), Tavily, or SerpAPI. (D-03-9, D-03-10)
# Stubs for Tavily/SerpAPI raise NotImplementedError in v0.1.
PERSONA_WEB_SEARCH_PROVIDER=brave
PERSONA_WEB_SEARCH_API_KEY=...

# web_fetch's truncation cap is NOT an environment knob. It is an argument the
# model passes per call, `web_fetch(url, max_chars=...)`, defaulting to 4000
# (D-03-3, packages/core/src/persona/tools/builtin/web_fetch.py). Nothing here
# changes it. It was listed as PERSONA_WEB_FETCH_MAX_CHARS for a while, which
# read like a knob and was silently swallowed when anyone set it.

# Sandbox root for file_read/file_write (D-03-23). Defaults to CWD-relative.
PERSONA_TOOLS_SANDBOX_ROOT=./.persona_work

# MCP servers: comma-separated name=url pairs (D-03-22). For EXTERNAL,
# bring-your-own MCP servers (the operator runs them; Persona ships no code).
# Each URL must be http:// or https://; the SDK negotiates Streamable HTTP (D-03-19).
# PERSONA_MCP_SERVERS=husleietvistutvalget=https://mcp.example.no/mcp,timekeeper=https://tk.example.com/mcp

# --- Built-in MCP servers (spec 27) ---
# Persona ships built-in MCP servers as thin FastMCP Streamable-HTTP subprocesses,
# bound to 127.0.0.1 only and spawned LAZILY (only when a persona actually uses one;
# D-27-3). Authored built-ins: time / calculator / filesystem (default-enabled) +
# weather (opt-in). fetch + github are NOT authored — configure them as external
# servers via PERSONA_MCP_SERVERS (D-27-11: the official fetch server has an
# unpatched SSRF CVE; github has an official remote endpoint + OAuth).
#
# Which authored built-ins to enable (comma-separated). UNSET → the safe subset
# time,calculator,filesystem (D-27-4). "" → opt out of all. "Enabled" means
# "available", NOT "running" — lazy spawn starts a server on first use.
# PERSONA_MCP_BUILTIN_ENABLED=time,calculator,filesystem,weather
#
# NOTE (Spec P4): the built-in `filesystem` server is scoped per-request to the
# owner+persona (<workspace_root>/<owner>/<persona>) — the supervisor spawns one
# filesystem subprocess per (owner, persona) and threads the pre-resolved scoped
# root in at spawn via the INTERNAL env var PERSONA_FILESYSTEM_SCOPE_ROOT. That
# var is supervisor-injected per spawn, NOT operator-configured — do not set it
# here. No scope bound ⇒ the server fails closed (denies), never the shared root.
#
# Optional POSIX uid the built-in MCP subprocesses drop to at spawn (D-27-12).
# UNSET (default) → children inherit the API process user; in production the API
# container runs as the non-root persona user (uid 1000), so its children do too.
# Set this only when the API itself runs as root and must drop privileges.
# PERSONA_MCP_BUILTIN_UID=1000
#
# The 'weather' built-in uses open-meteo (no key). Its free tier is
# NON-COMMERCIAL; a commercial deployment needs a paid open-meteo key or met.no
# (D-27-6). The 'github' EXTERNAL server expects a standard GitHub token (D-27-5):
# GITHUB_TOKEN=ghp_...

# --- Bring-your-own MCP credential encryption (spec 30) ---
# Encrypts user-supplied BYO MCP-server credentials at rest (Fernet/MultiFernet,
# D-30-4). One or more COMMA-SEPARATED url-safe-base64 Fernet keys — the FIRST
# encrypts, ALL decrypt (zero-downtime rotation: prepend a new key, re-encrypt,
# drop the old). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED to save a BYO MCP server that carries auth (a bearer token); unset →
# such a save fails loud (never stores a secret in plaintext). Never logged.
# Spec R8 reuses THIS key to encrypt OAuth access + refresh tokens (one channel).
# MCP_CREDENTIAL_KEY=

# --- MCP OAuth 2.1 (per-user Connect flow, spec R8) ---
# Open Persona is the OAuth *client*: the user clicks Connect → authenticates at the
# provider → back and connected, no token handling. Tokens are per-user, encrypted at
# rest (MCP_CREDENTIAL_KEY), refreshed+rotated, and NEVER logged/returned.
#
# The fixed HTTPS origin the OAuth redirect_uri is built from — the web callback page
# ({BASE}/mcp/oauth/callback) relays code+state to the authenticated API callback.
# Must be the origin registered at each provider. Unset → OAuth initiate fails closed.
# PERSONA_MCP_OAUTH_REDIRECT_BASE_URL=https://app.yourdomain.com
#
# GitHub pre-registered client (R8-D-7 / T9.5 operator runbook): GitHub supports no
# RFC 7591 DCR, so one-time register the Open Persona OAuth app at GitHub and set these.
# Unset client_id → GitHub is simply not offered as a provider. client_secret never logged.
# PERSONA_MCP_OAUTH_GITHUB_CLIENT_ID=
# PERSONA_MCP_OAUTH_GITHUB_CLIENT_SECRET=
# Space-delimited scopes (least-privilege default: repo).
# PERSONA_MCP_OAUTH_GITHUB_SCOPES=repo
#
# In-flight state TTL (seconds) and the refresh-before-inject leeway (refresh a token
# within this many seconds of expiry at persona load). Defaults are sensible.
# PERSONA_MCP_OAUTH_STATE_TTL_SECONDS=600
# PERSONA_MCP_OAUTH_REFRESH_LEEWAY_SECONDS=120

# --- Docker MCP Gateway (connect-only) ---
# Point the runtime at an externally-run Docker MCP Gateway and EVERY enabled
# server's tools become available through ONE connection — "enable once in Docker,
# then opt each persona in" (per-persona allow-list still gates: a persona only sees
# gateway tools it lists as mcp:docker:<tool>). CONNECT-ONLY: Persona connects, it
# never spawns the gateway (no Docker socket). The URL MUST be the gateway's
# STREAMABLE-HTTP endpoint — run it `--transport streaming --port <p>` and use the
# `/mcp` path (NOT the legacy `sse` transport). Operator deployment config (same trust
# tier as DATABASE_URL → not SSRF-pinned). Unset → no gateway source.
# PERSONA_DOCKER_MCP_GATEWAY_URL=http://127.0.0.1:8811/mcp
#
# Optional bearer for a NON-loopback gateway (a loopback gateway needs none). A
# secret: never logged, rides the Authorization header only — never a prompt/audit.
# PERSONA_DOCKER_MCP_GATEWAY_TOKEN=
#
# Cloud (PERSONA_EDITION=cloud) only: a cloud gateway is shared across tenants and
# must be operator-VETTED. With a gateway URL set, cloud REFUSES to start unless this
# acknowledges the vetted-shared posture (per-tenant gateways / container-running /
# per-user secret injection are deferred). Ignored in community (your own gateway).
# PERSONA_ALLOW_CLOUD_GATEWAY=1
#
# Populate the apps catalog (the ~300-server mirror of github.com/docker/mcp-registry)
# with the OFFLINE sync — never fetched at request time; absent → the built-in catalog:
#   uv run python -c "from pathlib import Path; from persona.tools.mcp.mirror_sync import sync_mirror; import persona.tools.mcp.mirror as m; sync_mirror(mirror_path=m.MIRROR_PATH)"

# --- Per-tenant MCP runtime (Spec N6; CLOUD only) ---
# Runs a user's chosen IMAGE-runtime MCP server (a Docker image with no remote URL, e.g.
# mcp/google-flights) as a Fly Machine PER (tenant, server) — their secret injected at
# spawn, isolated by the Firecracker microVM boundary. Resolves the deferred half of N1
# (the shared gateway couldn't vary a per-user secret). Community keeps N1's local gateway
# and never runs this. Unset FLY app/token → the runtime is OFF (assigned image servers
# report a not-connected badge; nothing runs per-tenant).
#
# The Fly app the per-tenant Machines live in + the Machines API token (Bearer; a SECRET,
# never logged). BOTH must be set for the runtime to turn on.
# PERSONA_MCP_RUNTIME_FLY_APP=open-persona-mcp
# FLY_API_TOKEN=
#
# The port the in-Machine stdio→HTTP bridge serves /mcp on (default 8000).
# PERSONA_MCP_RUNTIME_FLY_PORT=8000
#
# Idle-reap: a Machine idle longer than IDLE_TIMEOUT_S is stopped by the background reaper
# (sweep cadence REAP_INTERVAL_S). Bounds the per-active-tenant cost (defaults 300s / 60s).
# PERSONA_MCP_RUNTIME_IDLE_TIMEOUT_S=300
# PERSONA_MCP_RUNTIME_REAP_INTERVAL_S=60
#
# The per-tenant cap: at most this many image servers per tenant. Enforced at ASSIGN — the
# (N+1)th enable is denied (never a silent spawn-storm). Default 3.
# PERSONA_MCP_RUNTIME_MAX_PER_TENANT=3
#
# Cloud REFUSES to start with the runtime configured unless this acknowledges the posture:
# it runs third-party image code per-tenant with per-user secrets at a per-active-tenant
# cost (mirrors PERSONA_ALLOW_CLOUD_GATEWAY). Ignored in community.
# PERSONA_ALLOW_PER_TENANT_MCP=1
#
# The operator allow-list of catalog images permitted to RUN per-tenant (comma-list of
# catalog entry names). On top of the Docker-official `mcp/` namespace + provenance basis;
# the EMPTY default is DENY-ALL (fail-closed) — nothing runs per-tenant until vetted. NOT
# signature-based. Checked at BOTH assign and spawn (TOCTOU fail-closed).
# PERSONA_MCP_RUN_VETTED=google-flights,time

# --- Docker MCP catalog auto-sync (Spec N2) ---
# Keep the catalog mirror FRESH automatically: a leader-gated periodic task in the worker
# loop re-pulls github.com/docker/mcp-registry on a daily-ish cadence and reconciles the
# mirror (adds new servers, updates changed, marks removed). Availability updates
# automatically; ENABLING stays the per-persona allow-list (it never auto-enables).
#
# Where the auto-synced mirror is written + read. The bundled package-data mirror.json is
# baked into the image (root-owned, lost on redeploy), so the auto-sync writes to a path on
# the mounted persistent volume instead; the request-path loader PREFERS this over the
# bundled snapshot (precedence: this override -> bundled mirror.json -> built-in catalog).
# Unset (dev/local) -> the bundled snapshot is used and is also the sync's write target.
# In the hosted deploy set it under the mounted volume (e.g. /var/lib/persona/mcp/mirror.json).
# PERSONA_MCP_MIRROR_PATH=/var/lib/persona/mcp/mirror.json
#
# Opt-out switch for the periodic auto-sync (default true). false -> no periodic outbound
# git clone; availability stays at whatever the bundled snapshot provides (fail-soft).
# PERSONA_MCP_SYNC_ENABLED=true
#
# Auto-sync cadence in seconds (default 86400 = daily). The Docker catalog changes slowly,
# so one shallow clone/day from one process is plenty (and rate-limit-friendly).
# PERSONA_MCP_SYNC_INTERVAL_SECONDS=86400
#
# --- External skill sources auto-sync (Spec S2) ---
# A second mirror on the SAME leader-gated substrate, for the external skill catalog
# (Anthropic store / OpenClaw / arbitrary GitHub). DISABLED by default: availability stays at
# the last-synced snapshot (fail-soft). Enable to keep the external skill mirror fresh.
# PERSONA_SKILL_SYNC_ENABLED=false
# PERSONA_SKILL_SYNC_INTERVAL_SECONDS=86400
#
# The writable, reader-visible skill mirror location on the mounted volume (parallel to
# PERSONA_MCP_MIRROR_PATH). Unset (dev/local) -> the bundled path. In the hosted deploy set it
# under the volume (e.g. /var/lib/persona/skill_mirror/skill_mirror.json).
# PERSONA_SKILL_MIRROR_PATH=/var/lib/persona/skill_mirror/skill_mirror.json
#
# OpenClaw is opt-in: the curated community-skills repo to sync (empty -> OpenClaw not synced).
# The Anthropic source is a pinned code constant (no env knob); arbitrary GitHub is BYO.
# PERSONA_SKILL_OPENCLAW_REPO_URL=
# PERSONA_SKILL_OPENCLAW_REF=
#
# R9-040 — arbitrary-GitHub bring-your-own-repo skills: a comma list of owner/repo[@ref]
# entries, cloned + ingested via the existing hardened D1 adapter, landing in the mirror at
# third_party (consent-gated downstream by S3, same as any other external skill). Malformed
# entries WARN + skip (never fail config load). Empty (default) -> no GitHub repos synced.
# PERSONA_SKILL_GITHUB_REPOS=

# --- Skills (spec 04) ---
# TOKEN_BUDGET is a module constant (2000); no env knob in v0.1 (D-04-7,
# architecture §5.1.2 "non-negotiable"). User skills live in `skills/`
# alongside the persona YAML; absent directory silently skipped (D-04-5).
#
# R9-165 — a skill over its budget is SUMMARISED (small/background tier) instead of cut, as
# the architecture promises. The summary is made once, at boot and after each skill-mirror
# sync, and cached by the body's content hash; injecting a skill is a lookup, never a model
# call, so every turn gets the same body. false keeps the pre-fix behaviour end to end:
# truncate with a WARNING naming the skill and the overshoot. Default true.
# PERSONA_SKILL_SUMMARIES_ENABLED=true
# Where the summary cache file lives. Unset -> beside PERSONA_SKILL_MIRROR_PATH when that is
# set (the hosted volume), else <PERSONA_CHROMA_PATH>/skill_summaries.json (dev / community).
# PERSONA_SKILL_SUMMARY_CACHE_PATH=

# --- Logging ---
PERSONA_LOG_LEVEL=INFO
# PERSONA_LOG_FORMAT=pretty                # pretty | json
# PERSONA_LOG_FILE=/var/log/persona.log

# --- Spec 12 hosted sandbox (D-12-12 E2B — CONFIRMED via five lock-gates) ---
# Hosted sandbox substrate per D-12-12. E2B Hobby tier (free; $100 starter
# credit; no payment information required) at https://e2b.dev/. The SDK reads
# E2B_API_KEY natively — no extra wiring in our HostedSandbox adapter (T08).
# All five lock-gates ✅ PASS — see docs/specs/phase2/spec_12/audit/.
# **Install the SDK:** `uv pip install -e packages/api[hosted]` (pulls
# `e2b-code-interpreter>=1.0,<2`). The api package boots cleanly without the
# extra (lazy-import at use-site); only required when `E2B_API_KEY` is set.
# E2B_API_KEY=e2b_...

# --- Spec 12 T09 sandbox pool (D-12-17 locked configuration) ---
# Pool defaults read at api process startup via Pydantic Settings. v0.1 ships
# warm-pool=0 (lazy-eager prewarm on first acquire) — set nonzero only after
# D-12-17's warm-pool flip-trigger fires (production telemetry signal).
# PERSONA_SANDBOX_WARM_POOL_SIZE=0           # v0.1 locked to 0 by validator
# PERSONA_SANDBOX_REAP_INTERVAL_S=60         # background reaper sweep cadence
# PERSONA_SANDBOX_IDLE_TIMEOUT_S=300         # session staleness before reap
# PERSONA_SANDBOX_MAX_PER_USER=2             # per-tenant concurrent-session cap

# --- Spec 13 workspace (image uploads + Spec 15 generated images + Spec 16/17 sandbox produced files) ---
# Per-deployment workspace root. Every upload + generated image + produced
# file lands under <workspace_root>/<owner_id>/<persona_id>/... — RLS-scoped
# via the persona pre-flight on every route. Defaults to a .persona_work
# directory under the API process's CWD so a clean checkout boots without
# env setup. Set in production to a persistent volume.
# PERSONA_API_WORKSPACE_ROOT=./.persona_work

# --- LLM-assisted persona authoring (drafter) sampling ---
# The FIRST draft / refinement generation samples at these values so persona
# NAMES + personality come out distinctive and varied (not bland-greedy). The
# schema validation-repair RETRY is always deterministic (temperature 0.0) so
# raising creativity never weakens schema compliance. Tunable without redeploy.
# Temperature is the primary lever (default 0.9). top_p / top_k are optional —
# unset leaves the provider default untouched. top_p is honoured by OpenAI +
# Anthropic; top_k only by Anthropic / hf_local / ollama (NO-OP on OpenAI). The
# default authoring tier is Anthropic (PERSONA_FRONTIER_PROVIDER), so top_k DOES
# reach the model.
# PERSONA_API_AUTHORING_TEMPERATURE=0.9
# PERSONA_API_AUTHORING_TOP_P=0.95
# PERSONA_API_AUTHORING_TOP_K=60

# --- Spec 14 document ingestion ---
# PDF page rasterisation DPI for scanned-PDF VISION_HANDOFF (R-14-2 + D-14-2 sub).
# Default 150 (sweet spot for OCR-readable text); valid range 100–300.
# Operators tune up for fine-print legal documents; tune down for cost.
# PERSONA_DOC_PDF_RASTER_DPI=150
#
# Whole-inject vs chunk-retrieve token threshold (D-14-1). Docs under this
# many tokens are injected whole into the conversation; larger docs are
# chunked + retrieved. Default 3000; valid range 100–32000.
# PERSONA_DOC_INJECT_THRESHOLD=3000
#
# No-text-layer detection threshold (D-14-2) — extracted chars/page below
# this flags a PDF needs_vision_handoff (scanned page). Default 50.
# PERSONA_DOC_PDF_NO_TEXT_LAYER_THRESHOLD=50
#
# CSV/XLSX row cap before truncation to a first/last-50-rows sample (D-14-3).
# Default 1000; valid range 10–50000.
# PERSONA_DOC_SPREADSHEET_ROW_CAP=1000

# --- Spec 15 image generation (PERSONA_IMAGEGEN_* — env_prefix on ImageBackendConfig) ---
# Image generation is OFF by default — the API boots cleanly without these,
# but every POST /v1/personas/:id/imagegen returns 503 ImageGenUnavailableError
# until PERSONA_IMAGEGEN_API_KEY is set (the startup WARNING you see is the
# fail-fast surface). Set provider + model + key to enable.
#
# Operator hint (Spec 19 amendment, 2026-06-07): when PERSONA_IMAGEGEN_API_KEY
# is provisioned post-deploy, re-run F4 Journey 1 (the image-generation
# walkthrough at packages/web/e2e/f4-rich-output.spec.ts) — it flips from
# 🟦 PARTIAL (skipped on missing key) to ✅ PASS once the key resolves. See
# docs/specs/phase2/spec_F4/closeout.md "External smoke" + the Spec 15 §5
# cross-spec ledger editorial note for the full operator-pass procedure.
#
# Provider lock per D-15-1 + Spec 20 (nvidia) + Spec 22 (openrouter) +
# Spec 25 D-25-11..14 (cloudflare): openai | fal | nvidia | openrouter | cloudflare.
#
# RECOMMENDED DEFAULT (Spec 25 D-25-13): Cloudflare Workers AI — the only
# truly-free path. A free Cloudflare account gives 10,000 neurons/day
# (~170–230 flux-1-schnell images/day), no card required. flux-1-schnell is
# GA (stable pricing). It has NO width/height/guidance/negative_prompt knobs
# and a fixed output size — switch to OpenAI/fal (below) if you need those or
# higher fidelity. account_id is a SEPARATE var (D-25-12), not in the base URL.
# PERSONA_IMAGEGEN_PROVIDER=cloudflare
# PERSONA_IMAGEGEN_MODEL=@cf/black-forest-labs/flux-1-schnell
# PERSONA_IMAGEGEN_API_KEY=          # Cloudflare API token (Workers AI Read+Edit)
# PERSONA_IMAGEGEN_CLOUDFLARE_ACCOUNT_ID=   # 32-char hex, from the CF dashboard
#
# NOTE — two config FORMS for Cloudflare:
#   (a) Single-provider (triplet, above): account_id = PERSONA_IMAGEGEN_CLOUDFLARE_ACCOUNT_ID.
#   (b) Cross-provider MODELS list (PERSONA_IMAGEGEN_MODELS=cloudflare/@cf/...): the API key
#       resolves via the per-provider PERSONA_CLOUDFLARE_API_KEY, and the account_id via
#       PERSONA_CLOUDFLARE_ACCOUNT_ID (the imagegen-prefixed name is also accepted as a fallback).
#   Cloudflare allow-set (D-25-11): @cf/black-forest-labs/flux-1-schnell (GA, primary),
#   @cf/stabilityai/stable-diffusion-xl-base-1.0 (beta), @cf/lykon/dreamshaper-8-lcm (beta).
#
# PREMIUM-QUALITY ALTERNATIVE: openai (gpt-image-1.x — supports size/quality
# knobs; paid) | fal (Flux 1.1 [pro] via fal-client; paid). NVIDIA image gen
# is Enterprise-tier only (Spec 25 §2.10) — not a free option.
# PERSONA_IMAGEGEN_PROVIDER=openai
# PERSONA_IMAGEGEN_MODEL=gpt-image-1
# PERSONA_IMAGEGEN_API_KEY=sk-...
#
# Optional: override the provider's default base URL (proxy / self-hosted).
# PERSONA_IMAGEGEN_BASE_URL=https://api.openai.com/v1
#
# Optional: per-call HTTP timeout (seconds). Default 120.0; conservative
# upper bound that still surfaces dead-provider cases via ImageProviderError.
# PERSONA_IMAGEGEN_REQUEST_TIMEOUT_S=120.0
#
# Optional: fal.ai per-call safety_tolerance (1 strict – 6 permissive).
# Default 2 (fal API default, conservative end per D-15-X-provider-moderation-default).
# Ignored when PERSONA_IMAGEGEN_PROVIDER=openai.
# PERSONA_IMAGEGEN_FAL_SAFETY_TOLERANCE=2
#
# fal-client SDK reads FAL_KEY natively. ImageBackendConfig.api_key is the
# source of truth; the fal backend sets FAL_KEY in os.environ around the
# call and restores prior value after — no need to set FAL_KEY directly
# unless integrating with another tool that reads it.
# FAL_KEY=...

# --- Spec V2 streaming STT (PERSONA_STT_* — env_prefix on StreamingSTTConfig) ---
# Streaming STT is OFF by default — the voice loop falls back to V1's
# PassThroughEchoMode.ECHO until PERSONA_STT_API_KEY is set. With STT off,
# voice calls do not transcribe; V4/V5 turn-taking + persona model wiring
# wait for STT enablement.
#
# Operator hint (Phase-3 critic gate corrections, 2026-06-07): Deepgram
# streaming PAYG is $0.0048/min ($0.0042/min Growth); $0.0077/min is for
# pre-recorded transcription, NOT streaming. $200 signup credit covers
# Phase 5 prototype validation. PAYG concurrency cap is 150 streams
# (Feb 2026 tripling); v0.1 advisory-lock (D-V1-5) caps per-user to 1
# active call, so per-user STT spend = avg-call-duration * per-minute rate.
#
# Provider lock per D-V2-1: deepgram (Nova-3 Monolingual Streaming for
# Norwegian/Swedish/English; Nova-3 Multilingual for Arabic — one quality
# tier below; falsification triggers route to speechmatics behind same
# StreamingSTT Protocol seam). speechmatics is the documented alternative
# behind the Protocol; whisper-streaming is v0.2 cost-reduction candidate.
# PERSONA_STT_PROVIDER=deepgram
# PERSONA_STT_MODEL=nova-3
# PERSONA_STT_API_KEY=...
#
# Optional: override the provider's default base URL (proxy / self-hosted).
# PERSONA_STT_BASE_URL=https://api.deepgram.com
#
# Optional: per-call HTTP request timeout (seconds). Default 60.0.
# PERSONA_STT_REQUEST_TIMEOUT_S=60.0
#
# Optional: language hint forwarded to provider (overrides per-persona
# identity.language_default). Use ISO 639-1 codes: en / no / sv / ar.
# Per-session override possible via VoiceConfig wiring.
# DEPRECATED (Spec V14 D-V14-5): superseded by the per-call/per-request
# language plumbing (persona identity.language_default, the mic-dictation
# `language` field, and Gladia's own code-switch guidance below). Setting it
# now logs a one-time warning; it still applies to the deepgram incumbent
# (byte-identical), but has NO effect under provider=gladia (D-V14-15 —
# Gladia's guidance is per-request, never an env-level pin).
# PERSONA_STT_LANGUAGE_HINT=en
#
# --- Spec V14 Gladia streaming/batch STT (utterance-level code-switching) ---
# PERSONA_STT_PROVIDER=gladia switches the incumbent Deepgram lock (above) to
# Gladia — a language-AGNOSTIC provider that transcribes a code-switched
# utterance (e.g. English mid-sentence into Norwegian) with NO per-call
# language pin (the D-V14-1 property; the measured fix for R9-025's "Deepgram
# silently drops the second language"). One env flip; ROLLBACK is the SAME
# flip back to PERSONA_STT_PROVIDER=deepgram (the parked Gladia knobs below
# are simply unread).
# PERSONA_STT_PROVIDER=gladia
#
# Gladia API key (sign up at gladia.io — free "Starter" tier at T0 time).
# Escapes the PERSONA_STT_ prefix (spec-named, matches the owner's actual
# signup var) — read directly by StreamingSTTConfig via validation_alias.
# PERSONA_GLADIA_API_KEY=...
#
# Optional: Gladia model (default solaria-1 — the code-switching-CAPABLE
# model; solaria-3 does NOT code-switch, so this default is load-bearing).
# PERSONA_STT_GLADIA_MODEL=solaria-1
#
# Optional: speech-activity VAD library. Default silero per
# D-V2-X-silero-implementation-shape (ONNX-only path; MIT; bundled weights
# via silero-vad-lite — no torch transitive).
# PERSONA_STT_VAD_LIBRARY=silero
#
# Optional: Deepgram endpointing silence (ms before is_final=true on
# transcript message). Default 300; raise toward 500 for more conservative
# turn-end detection.
# PERSONA_STT_DEEPGRAM_ENDPOINTING_MS=300
#
# Optional: Deepgram UtteranceEnd silence (ms before UtteranceEnd event;
# independent from endpointing). Default 1000.
# PERSONA_STT_DEEPGRAM_UTTERANCE_END_MS=1000
#
# Optional: Silero speech-onset confirmation window (ms). Default 50
# (R-V2-2 wall-clock budget: typical 85-90 ms onset; worst-case
# 116-121 ms including SileroFramer; T12 measurement gates verify).
# PERSONA_STT_SILERO_MIN_SPEECH_DURATION_MS=50
#
# Optional: Silero silence-confirmation window (ms before speech_ended).
# Default 200; raise toward 600 for natural turn-end.
# PERSONA_STT_SILERO_MIN_SILENCE_DURATION_MS=200
#
# Optional: Silero activation threshold (0.0-1.0). Default 0.5; raise
# toward 0.7-0.8 in noisy environments (R-V2-2 + LiveKit production data
# show ~51 % FP rate untuned in conversational audio — V4 semantic
# turn-detector overlay is the load-bearing defense).
# PERSONA_STT_SILERO_ACTIVATION_THRESHOLD=0.5
#
# Optional: suppress Silero speech_started while the persona is speaking
# (the no-AEC TTS-mute stopgap). Default FALSE — a hard mute blocks a real
# barge-in onset, so the persona can't be interrupted while speaking AND the
# user's barge-in audio is withheld from the billed STT stream until it
# finishes (D-V8-X-bargein-during-speech-fix). Browser/transport AEC + the
# orchestrator confidence/confirm rejection are the real echo defense. Set
# TRUE only on a deployment proven to lack AEC.
# PERSONA_STT_SILERO_ECHO_MUTE_WHILE_SPEAKING=false

# --- Spec V3 streaming TTS (PERSONA_TTS_* — env_prefix on StreamingTTSConfig) ---
# Streaming TTS is OFF by default — the voice loop produces no synthesised
# speech until PERSONA_TTS_API_KEY is set. With TTS off, V5's reply text is
# not voiced; the outbound rail stays silent (or echoes in V1 pass-through).
#
# Cost discipline (D-V3-X-cost): TTS is the SECOND continuously-metered
# service on top of V2 STT (~0.48 cents/min) and the LLM (per-token) — a
# voice call meters three services every second. Cartesia is ~1 credit/char,
# effective ~ $0.023/min (~ 2.3 cents/min) on the Startup tier; assume
# worst-case 2x overage until published rates are confirmed. Per-session
# spend is logged in VoiceLog.tts_total_cents (T11) and verified at the T14
# external smoke. MAINTENANCE.md tracks the compounded STT+TTS+LLM quarterly
# cost-cadence review.
#
# Provider lock per D-V3-1: cartesia (Sonic 3.5 — WebSocket contexts API;
# native raw PCM16 mono 24 kHz; sub-90 ms first-audio; 42 langs incl.
# Norwegian/Swedish/Arabic; per-context cancel for V4 barge-in). elevenlabs
# (Flash v2.5) is the documented alternative behind the same StreamingTTS
# Protocol seam (falsification triggers route to it — EU TTFA, Nordic
# quality, or cost).
# PERSONA_TTS_PROVIDER=cartesia
# PERSONA_TTS_MODEL=sonic-3.5
# PERSONA_TTS_API_KEY=...
#
# Optional: override the provider's default base URL (proxy / self-hosted).
# PERSONA_TTS_BASE_URL=https://api.cartesia.ai
#
# Optional: per-call HTTP/WebSocket request timeout (seconds). Default 60.0.
# PERSONA_TTS_REQUEST_TIMEOUT_S=60.0
#
# Optional: default catalogue voice id (D-V3-4) used when a persona has no
# explicit identity.voice. Without it, a voice-less persona fails resolution
# with TTSVoiceNotFoundError. Browse the catalogue via the backend's
# list_voices (D-V3-3) to pick an id.
# PERSONA_TTS_VOICE_DEFAULT=...
#
# Chunking knobs (D-V3-2 — hybrid sentence-level + first-chunk-shorter). The
# rule-based chunker emits a short first chunk for fast time-to-first-audio,
# then sentence-level chunks for prosody. Defaults are the locked values; T14
# tunes against real first-audio latency.
# PERSONA_TTS_CHUNK_MIN_FIRST_CHARS=10
# PERSONA_TTS_CHUNK_MAX_FIRST_WORDS=30
# PERSONA_TTS_CHUNK_MIN_CHARS=20
# PERSONA_TTS_CHUNK_MAX_CHARS=300
#
# Optional: pinned Cartesia API-contract date (D-V3-1). Default 2026-03-01.
# PERSONA_TTS_CARTESIA_VERSION=2026-03-01
#
# Optional: Cartesia server-side text buffer (ms, 0-5000). Default 0 — the
# client chunker is load-bearing (D-V3-X-chunker-placement), so the provider
# buffer is zeroed to avoid double-buffering (chunking happens exactly once).
# PERSONA_TTS_CARTESIA_MAX_BUFFER_DELAY_MS=0
#
# Optional: V12 persona voice emotion (Spec V12). The persona's emotional stance
# (N5's feeling-tags, emitted in voice) maps to Cartesia Sonic-3 generation_config
# so the delivery SOUNDS the feeling, bounded by character + restrained. No flag
# turns the mapping on/off wholesale (it is additive + fail-soft to a flat read);
# but Cartesia's `emotion` control is BETA while speed/volume are stable, so this
# kill-switch drops the Beta emotion field (keeping the stable speed/volume base)
# with NO deploy if the Beta layer misbehaves in production. Default true.
# PERSONA_TTS_EMOTION_ENABLED=true

# --- Spec V14 ElevenLabs streaming TTS (utterance-level text-language auto-follow) ---
# PERSONA_TTS_PROVIDER=elevenlabs switches the incumbent Cartesia lock (above)
# to ElevenLabs — ONE voice_id speaks whatever language the REPLY TEXT is in;
# NO language_code is ever sent on the wire (the model infers language from
# the text itself — the D-V14-1 property, proven end-to-end at T5). One env
# flip; ROLLBACK is the SAME flip back to PERSONA_TTS_PROVIDER=cartesia (the
# parked ElevenLabs knobs below are simply unread, and every persona's
# ORIGINAL Cartesia voice_id is restored untouched — nothing was mutated).
# PERSONA_TTS_PROVIDER=elevenlabs
#
# ElevenLabs API key (sign up at elevenlabs.io — free tier at T0 time; T0
# measured the free tier DID serve rail-native pcm_24000 in practice, though
# ElevenLabs' own docs describe that format as a paid-tier feature —
# re-verify your account's actual entitlement before relying on it in prod).
# PERSONA_ELEVENLABS_API_KEY=...
#
# Optional: ElevenLabs model (default eleven_flash_v2_5 — the flash-class
# latency tier T0 measured at 158ms warm first-audio; eleven_multilingual_v2 /
# eleven_v3 trade latency for higher expressivity).
# PERSONA_TTS_ELEVENLABS_MODEL=eleven_flash_v2_5
#
# Optional: provider-scoped default voice id (D-V14-13) — the voice a
# voiceless/cross-provider-mismatched persona falls back to under
# provider=elevenlabs (parallel to PERSONA_TTS_VOICE_DEFAULT above, which
# stays the Cartesia-scoped default). In practice the T5a boot-time AUTO-REMAP
# (reconcile_voice_assignments) and create-time auto-pick usually assign each
# persona its OWN distinct voice before this shared default is ever reached.
# PERSONA_TTS_ELEVENLABS_VOICE_DEFAULT=...

# --- Spec 32 greet-first turn-0 bounds (PERSONA_VOICE_* — env_prefix on VoiceConfig) ---
#
# The persona answers the phone: the call rings until turn 0 (the greeting) is
# ready, then it speaks first. These knobs bound that opening so a call never
# rings forever (D-32-3). Defaults are the researched degrade ladder.
#
# How long turn 0 waits on the shared embedder warm-up before proceeding (s);
# the ring covers the rest of any remaining cold load (D-32-X-warmup-gates-turn0).
# PERSONA_VOICE_GREET_WARMUP_TIMEOUT_S=10.0
#
# How long the call may ring with no greeting audio before degrading to the
# user's floor (s) — the agent-side "never ring forever" bound.
# PERSONA_VOICE_GREET_TIMEOUT_S=30.0
#
# Per-turn liveness bound (R9-124): a user turn must put its first audio on the rail
# within this many seconds of the turn-end decision, else the generation is cancelled,
# a short spoken apology plays, and the floor returns to the user.
# PERSONA_VOICE_TURN_FIRST_AUDIO_TIMEOUT_S=20.0

# --- Spec V13 voice graph memory kill-switch (PERSONA_VOICE_* on VoiceConfig) ---
#
# Gates whether the K4-gated graph store is composed into the voice runner. OFF
# (default) ⇒ the call runs graph-OFF, byte-identical to today (no graph retrieval
# surfaced on voice). ON ⇒ the persona retrieves from the graph on a call, routed
# through K4's wellbeing gate (allowlist subtraction + recent-window lift + care-text
# surfacing + recency), off the loop with timeout-fail-soft. Ship OFF; flip ON only
# after the R4 operator pass ratifies latency (by ear) + spoken care. Governs the
# READ/surfacing path only — accumulation + episodic parity are never gated by it.
# PERSONA_VOICE_GRAPH_MEMORY_ENABLED=false

# --- Spec A9 voice task origination / delegation (PERSONA_VOICE_* on VoiceConfig) ---
#
# Gates whether the A9 origination gate is composed into the voice runner. OFF
# (default) ⇒ a spoken task/schedule/autonomy ask is handled as ordinary conversation,
# byte-identical to today (the gate is never consulted). ON ⇒ a recognized ask is
# echoed + confirmed for the ear and then DELEGATED to the chat pipeline — voice never
# executes with the mid model: the confirmed VERBATIM ask crosses as a durable
# ``delegated_turn`` A0 job, the api-side handler runs it on the frontier tier through
# the one audited path (loop.turn + tools/K4/approvals/R7 + the unchanged origination /
# steering doors), and a voice-side poller speaks the grounded result back on the call.
# Recognition sits behind a cheap cue regex (no model call on a no-cue turn); the create
# runs off the voice loop. Ship OFF; flip ON in-env only after the operator pass. The
# api-side ``delegated_turn`` worker tenant is built-but-inert until voice enqueues.
# PERSONA_VOICE_DELEGATION_ENABLED=false

# --- Spec V10 async-artifact production lane (PERSONA_VOICE_* on VoiceConfig) ---
#
# Cap on concurrent async-artifact tool tasks (e.g. generate_image) spawned
# per voice call by the async lane (V10-D-4) — bounds task-spawn + event-loop
# pressure without blocking the live turn. Default 3.
# PERSONA_VOICE_ASYNC_ARTIFACT_CONCURRENCY=3

# --- R9-202 per-call billable ceiling (PERSONA_VOICE_* on VoiceConfig) ---
#
# The most minutes ONE voice call can ever be billed for. A voice call charges
# the LiveKit infra rate per minute at teardown; billing now measures the
# CONVERSATION (the caller leaving the room, or the last committed turn) rather
# than how long the session object happened to live, and this ceiling is the
# second line of defence behind that. It bounds the CHARGE only: no call is ever
# cut short by it, and the record still stores the measured duration. A call
# that hits the ceiling is logged loudly with its call id.
# Default 120 (two hours). 0 disables the ceiling.
# PERSONA_VOICE_MAX_BILLABLE_CALL_MINUTES=120

# --- Spec K9 unified recall (PERSONA_RECALL_* — env_prefix on RecallSettings) ---
#
# The K9 fuse-score-gate recall path (episodic pyramid + graph fused into one
# reranked+gated path). MASTER GATE: OFF (default) ⇒ the loop runs today's two-path
# recall byte-identically; flip ON only after the operator pass.
# PERSONA_RECALL_UNIFIED_ENABLED=false
#
# The cross-encoder reranker gate (K9-D-3/D-4). OFF (default) ⇒ the fused order
# (no model constructed, no download). ON ⇒ the fused top-k is re-ordered by the
# cross-encoder below, behind the fail-soft shell: absence / load failure / timeout
# all degrade to the fused order — a rerank can never block or crash a turn.
# PERSONA_RECALL_RERANK_ENABLED=false
#
# HuggingFace hub id of the cross-encoder behind the reranker seam. The default is
# the K9-measured MiniLM-L6-class reference (~90 MB, CPU: top-12 p95 ~51 ms /
# top-20 p95 ~111 ms — inside the voice 120 ms / chat 800 ms deadlines). Loaded
# lazily on the first rerank, once per process, on CPU. P7 swaps a stronger
# chat-tier model here behind the same Scorer Protocol — pure config, no code change.
# PERSONA_RECALL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Spec K11 unified forget (PERSONA_FORGET_* — env_prefix on ForgetSettings) ---
#
# The similarity floor (1 = identical) a forget-preview candidate's cosine
# similarity to the concept node's content must clear to be OFFERED for
# cross-layer delete (D-K11-1). Off-turn only (the delete path, never a chat/voice
# turn) — matching runs on preview, so latency is a non-constraint (D-K11-8).
# PERSONA_FORGET_SIMILARITY_FLOOR=0.80

# --- Spec A0: durable execution — the worker service (persona_api.jobs) ---
#
# The worker is a SEPARATE long-lived process from the api (run it as its own
# Fly process / container: `python -m persona_api.worker` once the entrypoint is
# wired at deploy). It claims durable jobs from Postgres and runs them with
# crash-resume + retry. All knobs are optional; defaults shown.
#
# The worker's CROSS-TENANT dispatch engine DSN — claim/heartbeat/complete on the
# jobs tables only. Empty → falls back to DATABASE_URL (superuser) for v0.1. Point
# at a least-privilege `job_dispatcher` role (BYPASSRLS, granted on jobs/
# jobs_archive ONLY) to harden — pure config, no code change.
# WORKER_DISPATCH_DATABASE_URL=postgresql+psycopg://job_dispatcher:...@host/db
#
# WORKER_CONCURRENCY=4                      # async jobs in flight per worker process
# WORKER_POLL_INTERVAL_SECONDS=1.0          # base claim-poll interval
# WORKER_POLL_JITTER_SECONDS=0.5            # + U(0, jitter) so N workers don't thunder
# WORKER_CLAIM_LEASE_SECONDS=90             # bootstrap lease; per-job-type heartbeat extends it
# WORKER_DRAIN_SECONDS=270                  # graceful-drain budget; MUST be < Fly kill_timeout (300)
# WORKER_MAX_JOBS_PER_USER=3                # claim-time fairness cap (anti-starvation)
# WORKER_MAX_JOBS_GLOBAL=0                  # total in-flight cap; 0 = unlimited
# WORKER_MAINTENANCE_INTERVAL_SECONDS=30    # rescuer + cleaner + retention sweep cadence
# WORKER_ARCHIVE_AFTER_SECONDS=86400        # age terminal jobs into jobs_archive after this
# WORKER_ARCHIVE_RETENTION_SECONDS=2592000  # purge archive rows older than this (30 days)
#
# Avatar generation path. The durable queue is the default wherever this process's
# worker carries the avatar handler (an api restart mid-generation no longer loses
# the avatar); the in-request BackgroundTasks path is the automatic fallback when no
# worker consumes (community without one, keyless boots). This is the explicit
# opt-OUT: set to 1 to keep avatars in the request process even with a worker
# running (a worker being drained, a queue incident). Replaced the never-flipped
# PERSONA_API_AVATAR_VIA_QUEUE. The create contract is unchanged either way
# (POST → avatar_url=null + avatar_status=pending, the avatar appears on a later GET).
# PERSONA_API_AVATAR_INLINE_ONLY=0

# --- Spec R7: denial-of-wallet caps (per-user spend + concurrency) ---
# Three FAIL-LOUD money guards. All ride the edition seam: PERSONA_EDITION=cloud
# ENFORCES; community NO-OPs (the self-host single-owner path has no DoW surface —
# no advisory lock is taken and no row is written, so the SQLite backend is
# untouched). 0 = unlimited everywhere, so leaving a knob unset never regresses.
#
# CREDITS_MAX_PER_DAY — per-user credits/UTC-day HARD spend cap (the primary guard;
# atomic conditional-before-booking write, so two near-cap requests can't both pass).
# Over-cap → 429 + Retry-After = seconds to UTC midnight. Default 10000 ≈ 10% of the
# 100000 starter balance/day (~10-day floor for a normal user; a hard ceiling for an
# abuser). NOTE the fixed-window residual: a user can spend the full cap at 23:59 UTC
# AND again at 00:00 (a 2×-cap boundary burst). Accepted for v1 — bounded absolutely
# by the credit floor + the concurrency cap; a sliding window is future hardening,
# deliberately NOT v1.
# CREDITS_MAX_PER_DAY=10000
#
# MAX_CONCURRENT_BOUNDED_OPS_PER_USER — N in-flight slots for whole-op-in-one-txn ops
# (image generation, voice). Advisory-lock based (xact-scoped, auto-released). Default
# 1 preserves the shipped per-class cap exactly. Over-cap → 429 + Retry-After.
# MAX_CONCURRENT_BOUNDED_OPS_PER_USER=1
#
# MAX_CONCURRENT_LONG_OPS_PER_USER — N simultaneous long-running ops per user (chat
# SSE, agentic runs) whose work spans no single transaction. Durable-count based (an
# inflight_ops row per op, released when the op's worker terminates). Default 3. This
# is the parallel-spend race the per-day counter alone can't close (N long ops
# estimate cost up-front but book late). Over-cap → 429 + Retry-After.
# MAX_CONCURRENT_LONG_OPS_PER_USER=3
#
# Long-op crash-safety (durable-count internal invariant, not a knob): a killed
# process's inflight_ops row is reclaimed by a TTL staleness sweep at the next
# admission (default TTL 3600s, in code). INVARIANT: the TTL MUST exceed the longest
# legitimate long op. FAILURE POLARITY if it doesn't: a premature sweep evicts a LIVE
# op's row → the cap is briefly EXCEEDED (over-admit), never locked out; releasing an
# already-swept row is a harmless no-op. So set it too HIGH, never too low.

# --- Spec A1: scheduling — the scheduler tick (hosted in the worker) ---
# The tick is a single-leader poller inside the worker (leadership via a Postgres
# advisory lock — only one worker ticks at a time). It claims due schedules and
# materialises each into an A0 job keyed by schedule_id+fire_time (effectively-once).
# All config-driven (D-A1-2/D-A1-3); defaults shown.
# PERSONA_SCHEDULER_TICK_INTERVAL_SECONDS=30       # how often the leader ticks (jittered by the loop)
# PERSONA_SCHEDULER_BATCH_SIZE=100                  # max due schedules materialised per tick
# Missed-fire policy windows (a fire is "missed" when the worker was down across it):
# PERSONA_SCHEDULER_ON_TIME_TOLERANCE_SECONDS=120  # within this lateness → fire normally (caught promptly)
# PERSONA_SCHEDULER_DEFAULT_GRACE_SECONDS=10800     # recurring fire-late-once catch-up window (3h); per-schedule override
# PERSONA_SCHEDULER_ONE_TIME_GRACE_SECONDS=3600     # one-time fire-late-once catch-up window (1h)
# Beyond grace (or skip-and-note) → skip + a durable miss note; never burst-replay.

# --- The autonomous task model (Spec A2) -----------------------------------
# A task spans days through many bounded legs. Each knob below names the layer that reads
# it, and every default shown is the value the code uses when the knob is unset.
#
# PERSONA_TASK_CHECKPOINT_TOKEN_BUDGET=2000     # cap on the checkpoint's accumulating core
#                                               # (conclusions/decisions/lessons). Over budget
#                                               # the leg reflects and compacts; still over
#                                               # after that, the write fails loudly rather
#                                               # than persisting an ossifying checkpoint.
#                                               # Read by the api composition root, which
#                                               # hands it to every CheckpointStore on the
#                                               # leg path (the worker's, and the approval
#                                               # resume that also writes a checkpoint).
# PERSONA_TASK_LEG_WALLCLOCK_SECONDS=180        # per-leg wall-clock bound. It must sit inside
#                                               # the worker's drain window with room for the
#                                               # checkpoint commit (30s margin below 270s),
#                                               # so change it with the drain, not alone.
#                                               # Read by the worker composition root.
# PERSONA_TASK_LEG_MAX_STEPS=20                 # per-leg step bound, matching the chat loop's
#                                               # own default. Raised from 10 after a real
#                                               # hourly brief spent every step fetching and
#                                               # was cancelled before it could synthesise,
#                                               # billing in full for nothing.
#                                               # Read by the worker composition root.
# PERSONA_TASK_LEG_BUDGET_MICROS=               # optional per-leg spend cap (amount_micros).
#                                               # Empty or unset = no configured cap, and the
#                                               # box still bounds on steps and wall clock.
#                                               # It is a CEILING, never a grant: the leg gets
#                                               # the SMALLER of this and whatever its task's
#                                               # own budget has left, so raising it can never
#                                               # let a leg outspend the per-task cap.
#                                               # Read by the worker composition root.
# PERSONA_TASK_RECENT_LEG_SUMMARIES=3           # last-N leg summaries in reconstruction (max 5)
# PERSONA_TASK_SEMANTIC_DISTILLER_ENABLED=true  # model-backed checkpoint distiller: a leg
#                                               # carries a PLAN forward, not only findings.
#                                               # ON since W1 T13, after the continuation eval
#                                               # judged it 3/3 coherent (zero amnesia, zero
#                                               # ossification) with the distiller in the loop.
#                                               # Set false to run the deterministic writer,
#                                               # which is also the fallback for every timeout,
#                                               # refusal or malformed answer while it is on.
# PERSONA_TASK_SEMANTIC_DISTILLER_TIER=small    # tier the distillation runs on (small | mid)
# PERSONA_TASK_SEMANTIC_DISTILLER_TIMEOUT_SECONDS=45
#                                               # how long a distillation may take before
#                                               # the leg falls back to the deterministic
#                                               # writer. A reasoning small tier wants the
#                                               # 45; a fast hosted one needs far less.
# PERSONA_TASK_LEG_MAX_IDLE_DAYS=7              # how far ahead a leg may defer itself. The
#                                               # distiller can say there is nothing to do
#                                               # before a known time (a sale opens Thursday)
#                                               # and the next leg is scheduled for it instead
#                                               # of running at once. Past this many days the
#                                               # time is dropped and the leg continues now;
#                                               # a longer wait belongs on the schedule.
# PERSONA_TASK_ACCEPTANCE_ASSESSOR_ENABLED=true # lets a leg's work tick the contract's
#                                               # acceptance criteria off "pending". The
#                                               # model only PROPOSES; a core gate refuses
#                                               # any claim that cites no file the leg wrote
#                                               # and no source it read. Set false and every
#                                               # criterion stays pending for the life of the
#                                               # task, which is what it did before.
# PERSONA_TASK_ACCEPTANCE_ASSESSOR_TIER=small   # tier the assessment runs on (small | mid)
# PERSONA_TASK_ACCEPTANCE_ASSESSOR_TIMEOUT_SECONDS=20
#                                               # how long the assessment may take before the
#                                               # leg moves on without it. Shorter than the
#                                               # distiller's: a missed criterion stays
#                                               # pending and a later leg can claim it.
# PERSONA_TASK_WORKSPACE_RETENTION_DAYS=7       # how long a terminal task's Spec-12 workspace survives before destroy

# --- Connectors: reach your persona on chat apps (Specs C1/C2/C3) -----------
# The `persona-connectors` service (`python -m persona_connectors`, a separate process that
# reuses the api chat flow + C0 delivery) makes a persona reachable in chat-app DMs. A
# platform is wired iff its bot token is set; configured platforms run concurrently. All
# tokens are SecretStr — never logged. Idle conversations end after a tunable gap.
# PERSONA_CONNECTORS_IDLE_TIMEOUT_MINUTES=30
# Cloud edition shares the api DB through TWO roles, like the api itself (R9-123): the
# dispatch engine resolves an inbound platform identity to its owner BEFORE any owner
# scope exists, so it needs a role that sees across tenants (BYPASSRLS); every
# owner-scoped read and write then runs on the non-superuser persona_app role. Never
# point the second at a superuser: Postgres exempts superusers from every RLS policy.
# PERSONA_CONNECTORS_DATABASE_URL=postgresql+psycopg://persona:...@host:5432/persona
# PERSONA_CONNECTORS_APP_DATABASE_URL=postgresql+psycopg://persona_app:...@host:5432/persona

# Telegram (Spec C2): the bot-token + deep-link carrier; webhook (prod) or long-poll (dev).
# PERSONA_CONNECTORS_TELEGRAM_BOT_TOKEN=         # @BotFather token (required to run Telegram)
# PERSONA_CONNECTORS_TELEGRAM_TRANSPORT=longpoll # longpoll (dev, zero-infra) | webhook (prod)
# PERSONA_CONNECTORS_TELEGRAM_WEBHOOK_SECRET=    # constant-time-validated before parsing (webhook)
# PERSONA_CONNECTORS_TELEGRAM_WEBHOOK_URL=       # public HTTPS endpoint (webhook mode)
# PERSONA_CONNECTORS_TELEGRAM_BOT_USERNAME=      # for the t.me deep link (else resolved via getMe)

# Discord (Spec C3): a DM adapter over the gateway (WebSocket inbound) + OAuth identity link.
# DM-ability needs a mutual guild / user-install — the identify+bot consent establishes it.
# PERSONA_CONNECTORS_DISCORD_BOT_TOKEN=          # bot token (required to run Discord); rides in the Authorization header
# PERSONA_CONNECTORS_DISCORD_OAUTH_CLIENT_ID=    # OAuth2 app client id (identity linking)
# PERSONA_CONNECTORS_DISCORD_OAUTH_CLIENT_SECRET=
# PERSONA_CONNECTORS_DISCORD_OAUTH_REDIRECT_URI= # the registered OAuth callback URL
# PERSONA_CONNECTORS_DISCORD_LINK_TOKEN_TTL_MINUTES=15

# Slack (Spec C3): a DM adapter; DMs are unconditional once installed. Default transport is
# SOCKET MODE (an outbound WS — no public endpoint, the xapp app-token authenticates it).
# PERSONA_CONNECTORS_SLACK_BOT_TOKEN=            # xoxb-… bot token (required to run Slack)
# PERSONA_CONNECTORS_SLACK_TRANSPORT=socket      # socket (default, zero-infra) | http (public signed endpoint)
# PERSONA_CONNECTORS_SLACK_APP_TOKEN=            # xapp-… app-level token (REQUIRED for socket mode)
# PERSONA_CONNECTORS_SLACK_SIGNING_SECRET=       # v0= HMAC signing secret (REQUIRED for http-events mode)
# PERSONA_CONNECTORS_SLACK_OAUTH_CLIENT_ID=      # OAuth v2 app client id (identity linking)
# PERSONA_CONNECTORS_SLACK_OAUTH_CLIENT_SECRET=
# PERSONA_CONNECTORS_SLACK_OAUTH_REDIRECT_URI=
# PERSONA_CONNECTORS_SLACK_LINK_TOKEN_TTL_MINUTES=15
# Slack rejects an install with "No scopes requested" if either of the next two is ever
# emptied — leave them set (or override with your own app's scopes, never blank).
# PERSONA_CONNECTORS_SLACK_SCOPE=im:history,chat:write,im:write  # bot scopes: receive DMs, reply, open the DM channel
# PERSONA_CONNECTORS_SLACK_USER_SCOPE=identity.basic             # user scope: the installer's own Slack id

# ============================================================================
# Persona Voice & Character (Spec V11) — turn-time crisis safety gate
# ============================================================================
# The R1 turn-time safety gate runs over the user message on the chat, agentic, and
# voice paths. It composes a sub-millisecond lexical detector with the R6 fine-tuned
# multilingual encoder (euphemistic / non-English recall). An acute crisis signal takes
# the persona out of the loop and emits a deterministic, LOCALIZED safe completion
# (nb/ar/sv/da/tr/ur + English) instead of generating. Default ON.
#
# MASTER SWITCH. Setting it false is FAIL-SOFT — the classifier returns NONE and the
# always-on character-lock wellbeing floor (R0) still applies; it never removes all
# crisis handling.
# PERSONA_SAFETY_ENABLED=true
#
# R6 ENCODER SWITCH. false ⇒ the encoder path is skipped and the verdict is LEXICAL-ONLY
# (byte-identical to the pre-R6 baseline); the R0 floor still applies. An operator toggling
# this can only remove the *added* euphemistic/non-English recall, never crisis handling.
# Disable it in a no-model / offline edition to skip the ~470 MB model download.
# PERSONA_SAFETY_ENCODER_ENABLED=true
#
# R6 ENCODER THRESHOLDS (calibrated artifacts, not free knobs — re-tune only with a fresh
# eval + a version bump). T_SOFT ⇒ the recall net (SOFT); T_HARD ⇒ the out-of-band bypass
# (HARD). A false HARD is a product harm, so T_HARD is tuned to hold false-bypass at 0.
# PERSONA_SAFETY_ENCODER_T_SOFT=0.49
# PERSONA_SAFETY_ENCODER_T_HARD=0.75
#
# R6 ENCODER HANG-GUARD (seconds), NOT a latency SLA. A hung/wedged encoder must not stall
# the message path: on timeout the verdict degrades to LEXICAL-ONLY (fail-soft → R0).
# POLARITY: set it GENEROUSLY above the target VM's measured p99 — a too-TIGHT timeout
# silently drops the euphemistic/non-English recall under load (false timeouts → lexical).
# 0 / negative ⇒ no timeout (inline call). Default 2.0s is a hang-guard on a warm ~40 ms
# score; tune to the deployment's measured p99.
# PERSONA_SAFETY_ENCODER_TIMEOUT_S=2.0

# =============================================================================
# A7 — EVENT TRIGGERS  (the persona's "third impulse": react to typed platform
# events, not only clocks (A1) and scans (A5)). "When an email from my landlord
# arrives, summarise it." Feature-gated OFF; nothing registers, matches, or fires
# — and the NL event-trigger recognizer stays inert — until enabled. The two
# doors (fire a confirmed task's leg OR enqueue an A5 candidate) obey every
# existing consent/safety gate. See docs/decisions/spec_A7.md.
# =============================================================================
#
# The feature gate. OFF ⇒ byte-identical to pre-A7 (the dispatcher registers
# nothing and matches nothing; the recognizer's event branch never fires).
# PERSONA_EVENT_TRIGGERS_ENABLED=false
#
# The per-trigger coalescing window (seconds). Within it, an inbound burst
# coalesces into ONE fire carrying the count; the rest drop-with-audit (storm
# safety). Must be > 0.
# PERSONA_EVENT_TRIGGERS_COOLDOWN_SECONDS=300
#
# The provenance-chain depth cap — the belt-and-braces loop backstop for a cycle
# threading DISTINCT triggers (the primary guard is the causal-chain-contains
# refusal, which is unconditional). Must be > 0.
# PERSONA_EVENT_TRIGGERS_MAX_CHAIN_DEPTH=3
#
# The per-owner ceiling above the per-trigger cooldown (the pile-on guard across
# many triggers); over-cap ⇒ drop-with-audit + a durable P6 bell. Must be > 0.
# PERSONA_EVENT_TRIGGERS_PER_OWNER_MAX_FIRES_PER_HOUR=60
#
# The nominal per-fire cost booked against R7's day-cap at the pre-enqueue
# consult. 0 ⇒ the R7 primitive no-ops (community/uncapped unaffected). Must be >= 0.
# PERSONA_EVENT_TRIGGERS_FIRE_COST_ESTIMATE=1

# ---------------------------------------------------------------------------
# Spec A6 (Autonomy UI). A6 adds NO new env vars of its own — the surfaces + the
# thin RLS endpoints compose over existing A2/A3/A5 stores. It DOES read A5's
# initiative feature-gate for the honest dial flag (the Review/Tasks dial shows
# "won't act until enabled" when this is off), so it is surfaced here for A6's
# sake even though A5 owns it. Default OFF (the criterion-9 gate).
# PERSONA_INITIATIVE_ENABLED=false

# ---------------------------------------------------------------------------
# Spec M3 (Universal real-cost metering & credit billing). Every paid surface
# recovers its REAL provider cost through one formula:
#   credits = max(floor, ceil(MARKUP * (provider_cents + infra_flat_cents)))
# at 1 credit = 1c. All vars below are OPTIONAL — the defaults ship the current
# economics (MARKUP 1.0 = pure pass-through; the ~1.4x margin is M4's to set).
# The human pricing table is docs/pricing/pricing-table.md (the runtime reads the
# code registry persona.billing.pricing_registry, never the markdown).
#
# The one global markup multiplier on (provider + infra) cost. 1.0 = pass-through.
# PRODUCTION (Spec M4 T8, D-M4-2): set 2.0 — the M4 margin. The CODE default stays
# 1.0 (the M3 parity floor pins default-config behavior), so the margin is a
# deployment flip (owner go-live leg: `fly secrets set PERSONA_CREDIT_MARKUP=2.0`);
# rollback = flip back to 1.0 (env-flip discipline, no deploy).
# PERSONA_CREDIT_MARKUP=2.0
#
# Per-unit INFRA flat rates in cents (our own hosting/compute) — the SOLE charge
# for zero-provider surfaces (sandbox, LiveKit transport) and, where applicable,
# an additive component. Sub-cent infra inside an enclosing billed op (embeddings
# / connectors / MCP) is subsumed by that op's credit floor (T7) — these rates
# fire only for a genuinely standalone op.
# PERSONA_INFRA_RATE_PER_LLM_CALL_CENTS=0.1
# PERSONA_INFRA_RATE_PER_IMAGE_CENTS=1.0
# PERSONA_INFRA_RATE_PER_VOICE_MIN_CENTS=1.0     # LiveKit transport per voice minute
# PERSONA_INFRA_RATE_PER_EMBED_BATCH_CENTS=0.1
# PERSONA_INFRA_RATE_PER_TOOL_CALL_CENTS=0.1
# PERSONA_INFRA_RATE_PER_SANDBOX_EXEC_CENTS=1.0
#
# Authoring model override (Spec M3 T2c). A catalog/tier model string that pins
# persona authoring to a specific model; unset = today's frontier-tier behaviour.
# Billing is unaffected either way — it prices the ACTUAL served model.
# PERSONA_AUTHORING_MODEL=
#
# Per-surface minimum credit charges (the floor; infra rides the floor per the
# D-M3-4 amendment) + the image denial-of-wallet ceiling (pre-deducted before the
# provider call, then trued-up to the real cost). These carry the PERSONA_API_
# prefix (they are api-layer config, not the core billing formula above).
# Looking for PERSONA_API_AUTHORING_CREDIT_COST? M3 retired it (D-M3-9). Authoring
# is priced on the real cost of the model that actually served the call, and the
# floor below is the minimum charge. There is no flat per-call price any more.
# PERSONA_API_AUTHORING_CREDIT_FLOOR=1
# PERSONA_API_IMAGE_CREDIT_FLOOR=1
# PERSONA_API_IMAGE_CEILING_CREDITS=50
# PERSONA_API_AGENTIC_CREDIT_FLOOR=1
#
# The per-step context cost above which an agentic run trims tool results older than
# its last two steps down to a bounded head, with a marker saying what was cut. A cost
# ceiling, not a model-window one: the window compactor never fires in a real task leg,
# while the leg's cost climbs with every step it carries. 0 disables pruning.
# PERSONA_API_AGENTIC_CONTEXT_COST_CEILING_TOKENS=12000
#
# Voice billing (T6): per-turn STT+TTS+LLM is priced at the actually-served
# provider's rate (Gladia/ElevenLabs primary, Deepgram/Cartesia fallback) — the
# rates live in the pricing registry, not env; the LiveKit per-minute infra tick
# uses PERSONA_INFRA_RATE_PER_VOICE_MIN_CENTS above. The served TTS provider is
# selected by the voice service's PERSONA_TTS_PROVIDER (mirrored here, elsewhere
# in this file). No M3-specific voice env var is required.
#
# --- Spec M4 (Payments, Plans & Free-Tier) — Stripe billing (T2a) ---
# M4 ships DARK: the Stripe surface is constructed ONLY when the edition is `cloud`
# AND this flag is on AND a secret key is present. Default OFF → community and every
# not-yet-configured deploy carry zero billing (the `stripe` SDK is never imported).
# Owner legs at go-live: create the Stripe Products/Prices, supply the keys (test
# then live), enable Stripe Tax, set the webhook endpoint, then flip the flag.
# Never commit real key values.
# PERSONA_BILLING_STRIPE_ENABLED=false
# PERSONA_STRIPE_SECRET_KEY=          # sk_test_… then sk_live_… (server-side only)
# PERSONA_STRIPE_PUBLISHABLE_KEY=     # pk_test_… then pk_live_… (client-side; web Stripe.js)
# PERSONA_STRIPE_WEBHOOK_SECRET=      # whsec_… (the T3 webhook signature-verification input)
# Plan → Stripe Price id (T2b) — the owner creates the Products/Prices; these stay
# config (Free is not a Stripe subscription, so it has no Price). Checkout/portal
# redirect back to these web URLs.
# PERSONA_STRIPE_PRICE_PLUS=          # price_… for the Plus $15/mo recurring Price
# PERSONA_STRIPE_PRICE_PRO=           # price_… for the Pro $50/mo recurring Price
# PAYG one-time dollar-pack Price ids (T4a) — $5/$10/$25/$50, 12-month per-lot expiry.
# PERSONA_STRIPE_PRICE_PACK_5=        # price_… for the $5 pack (500 credits)
# PERSONA_STRIPE_PRICE_PACK_10=       # price_… for the $10 pack (1000 credits). ALSO the Price the Pro
#                                     # auto top-up bills off-session as a taxed invoice; unset, auto top-ups
#                                     # refuse (logged) rather than charge an untaxed amount.
# PERSONA_STRIPE_PRICE_PACK_25=       # price_… for the $25 pack (2500 credits)
# PERSONA_STRIPE_PRICE_PACK_50=       # price_… for the $50 pack (5000 credits)
# PERSONA_STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/billing/success
# PERSONA_STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/billing/cancel
# PERSONA_STRIPE_PORTAL_RETURN_URL=https://app.example.com/settings/billing
# The M4 margin: PERSONA_CREDIT_MARKUP=2.0 (documented in the Spec M3 metering
# section above) — an owner go-live leg alongside the Stripe keys, not a code default.
# No env var gates auto-top-up (T7b): it is a per-user DB opt-in
# (subscription.auto_topup_enabled, Pro-only, off by default) riding the same
# Stripe gateway — active only when the billing flag above is on.
#
# Spec A3 lifecycle sweeps (wiring audit) — the leader-gated worker periodics that keep
# autonomy honest: the approval expiry/reminder sweep (no zombie waits) and the dead-leg
# voicing sweep (a retry-exhausted task parks waiting-on-user + is voiced, never orphans).
# Cadences are coarse (at-most-once via CAS/idempotency, not the cadence); the remind/expire
# thresholds are the platform defaults. All optional — defaults are sensible.
# PERSONA_APPROVAL_SWEEP_INTERVAL_SECONDS=300
# PERSONA_APPROVAL_REMIND_AFTER_HOURS=24
# PERSONA_APPROVAL_EXPIRE_AFTER_HOURS=72
# PERSONA_DEAD_LEG_SWEEP_INTERVAL_SECONDS=120
# How often the revival sweep looks for work that stopped for a reason that has passed:
# a task whose leg was consumed without running (autonomy paused and then resumed, a
# persona unsuspended) and a task parked on a transient failure, which it picks up once
# on the owner's behalf. Nothing it finds is urgent, so it runs slower than the dead-leg
# sweep.
# PERSONA_REVIVAL_SWEEP_INTERVAL_SECONDS=300
# How often the worker looks for conversations that are still unnamed and have enough
# said in them to name, and queues the ordinary title job for each. New conversations are
# named at their first completed exchange whatever the channel, so this only ever catches
# a backlog or a conversation whose write path never reached the trigger (a call whose
# teardown died with the process). Once a backlog is drained it costs one indexed query.
# PERSONA_TITLE_BACKFILL_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# R9-025 reopen leg A — persona-voice (:8001) dev auth posture. The voice
# service verifies bearers the SAME way persona-api does (shared
# persona.auth.jwt_verifier.make_jwt_verifier) — it just needs ITS OWN copy of
# the same four PERSONA_API_JWT_* knobs, prefixed PERSONA_VOICE_ instead. Two
# documented dev postures (persona_voice/http/app.py's get_verify_token):
#
#   (1) RS256 against a Clerk-dashboard PEM — the SAME one persona-api uses,
#       and the SAME one packages/api/run-local.sh already exports when it
#       launches persona-voice alongside the api (reads
#       packages/api/.secrets/clerk-jwt-public.pem). If you run persona-voice
#       via run-local.sh, this is already wired — nothing to add here.
#       If you run persona-voice standalone (`uv run uvicorn
#       persona_voice.http.app:create_app --factory --port 8001`, per its
#       README), set:
#         PERSONA_VOICE_JWT_ALGORITHMS=RS256
#         PERSONA_VOICE_JWT_AUDIENCE=persona-api
#         PERSONA_VOICE_JWT_PUBLIC_KEY=<contents of packages/api/.secrets/clerk-jwt-public.pem>
#
#   (2) HS256 against a shared secret — lighter, no PEM to source, fine for a
#       pure backend-only dev loop (the browser's real Clerk-issued RS256
#       token will NOT verify against this — only use it with a hand-minted
#       HS256 test token):
#         PERSONA_VOICE_JWT_ALGORITHMS=HS256
#         PERSONA_VOICE_JWT_SECRET=<any dev-only secret string>
#
# PERSONA_EDITION=cloud is required for either to matter (community is
# no-auth by design — see persona_voice/config.py). Neither key set + cloud
# edition now 401s cleanly (was an unhandled crash pre-reopen) — see
# get_verify_token's docstring.
#
# PERSONA_TTS_VOICE_DEFAULT — separately, the voiceless-persona TTS fallback
# (leg A item 3): the voice-side catalogue voice_id POST /v1/tts uses when the
# caller sends no voice_id (a persona with no identity.voice). Same knob the
# realtime call stack already falls back to (D-V3-4) — set it to any voice_id
# GET /v1/voices returns for your configured PERSONA_TTS_API_KEY provider.
# PERSONA_VOICE_JWT_ALGORITHMS=RS256
# PERSONA_VOICE_JWT_AUDIENCE=persona-api
# PERSONA_VOICE_JWT_PUBLIC_KEY=
# PERSONA_VOICE_JWT_SECRET=
# PERSONA_TTS_VOICE_DEFAULT=

