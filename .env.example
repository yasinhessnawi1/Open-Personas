# os.environ literals). Everything below is COMMENTED OUT = code default; uncomment
# to override. New vars introduced by a spec must be added here at its close-out.
# ============================================================================


# ---- API service (persona_api.config.APIConfig) ----
#APP_DATABASE_URL=
